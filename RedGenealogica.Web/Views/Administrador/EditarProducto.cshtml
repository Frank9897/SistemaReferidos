@* EditarProducto.cshtml — Views/Administrador/EditarProducto.cshtml *@
@model RedGenealogica.Web.Models.Producto
@{ ViewData["Title"] = "Editar producto"; }

<div class="admin-tabs">
    <a href="/Administrador/Usuarios" class="admin-tab">Usuarios</a>
    <a href="/Administrador/Productos" class="admin-tab active">Productos</a>
    <a href="/Administrador/Retiros" class="admin-tab">Retiros</a>
</div>

<div style="max-width:780px;">
    <div class="section-title">✏️ Editar producto</div>
    <div class="section-subtitle">@Model.Nombre</div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="validation-summary-errors"></div>

        @* ── Datos básicos ─────────────────────────────────────────── *@
        <div class="card" style="margin-bottom:14px;">
            <div class="card-header"><span class="card-title">📋 Datos generales</span></div>

            <div class="form-group">
                <label asp-for="Nombre">Nombre *</label>
                <input asp-for="Nombre" />
                <span asp-validation-for="Nombre" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion">Descripción</label>
                <textarea asp-for="Descripcion" rows="3" style="resize:vertical;"></textarea>
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div class="form-group">
                    <label asp-for="Precio">Precio ($) *</label>
                    <input asp-for="Precio" id="inputPrecio" type="number" step="0.01" oninput="actualizarCalculadora()" />
                    <span asp-validation-for="Precio" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StockDisponible">Stock (vacío = ilimitado)</label>
                    <input asp-for="StockDisponible" type="number" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ImagenUrl">URL de imagen</label>
                <input asp-for="ImagenUrl" />
            </div>
        </div>

        @* ── Comisión al abuelo ────────────────────────────────────── *@
        <div class="card" style="margin-bottom:14px;">
            <div class="card-header">
                <span class="card-title">💰 Comisión al abuelo</span>
                <span id="badge-zona" class="badge badge-success" style="font-size:11px;">Zona segura</span>
            </div>

            <div style="background:rgba(56,189,248,0.06); border:1px solid rgba(56,189,248,0.15); border-radius:var(--radius-sm); padding:14px; margin-bottom:16px; font-size:13px; color:var(--text-muted); line-height:1.7;">
                <strong style="color:var(--sky);">¿Qué es esto?</strong><br>
                Cuando el <em>hijo</em> completa 3 referidos pagos, su padre gana el precio como premio.
                El <em>abuelo</em> recibe este % del precio como bono extra. El rango del abuelo amplifica el porcentaje.
            </div>

            <div style="display:grid; grid-template-columns:220px 1fr; gap:20px; align-items:start;">
                <div class="form-group" style="margin-bottom:0;">
                    <label asp-for="PorcentajeAbueloComision">% base del precio *</label>
                    <input asp-for="PorcentajeAbueloComision"
                           id="inputPorcentaje"
                           type="number" step="0.01" min="0" max="66"
                           oninput="actualizarCalculadora()"
                           style="font-size:18px; font-weight:600;" />
                    <span asp-validation-for="PorcentajeAbueloComision" class="field-validation-error"></span>
                    <div id="msg-advertencia" style="display:none; margin-top:6px; font-size:12px; color:var(--amber);">
                        ⚠️ Zona agresiva — revisá la calculadora
                    </div>
                    <div id="msg-bloqueado" style="display:none; margin-top:6px; font-size:12px; color:var(--red);">
                        🚫 Superaste el límite de 66%
                    </div>
                </div>

                <div id="calculadora" style="background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); padding:16px;">
                    <div style="font-size:11px; color:var(--text-muted); margin-bottom:12px; text-transform:uppercase; letter-spacing:0.5px;">Simulación por ciclo (3 referidos)</div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; justify-content:space-between; font-size:13px;">
                            <span style="color:var(--text-muted);">Ingreso del ciclo (3 × precio)</span>
                            <span id="calc-ingreso" style="color:var(--text); font-weight:500;">$0</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:13px;">
                            <span style="color:var(--text-muted);">Premio al sponsor (hijo)</span>
                            <span id="calc-premio" style="color:var(--red);">−$0</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:13px;">
                            <span style="color:var(--text-muted);">Bono al abuelo (base)</span>
                            <span id="calc-bono" style="color:var(--amber);">−$0</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:13px;">
                            <span style="color:var(--text-muted);">Bono máximo (abuelo Diamante +80%)</span>
                            <span id="calc-bono-max" style="color:var(--amber);">−$0</span>
                        </div>
                        <div style="height:1px; background:var(--border); margin:4px 0;"></div>
                        <div style="display:flex; justify-content:space-between; font-size:14px; font-weight:600;">
                            <span style="color:var(--text-muted);">Margen mínimo del negocio</span>
                            <span id="calc-margen" style="color:var(--green);">$0</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; font-size:12px;">
                            <span style="color:var(--text-muted);">Margen en % sobre ingreso</span>
                            <span id="calc-margen-pct" style="color:var(--text-muted);">0%</span>
                        </div>
                    </div>
                    <div id="zona-info" style="margin-top:12px; padding:10px 12px; border-radius:var(--radius-sm); font-size:12px; line-height:1.5; background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.2); color:#4ADE80;">
                        ✅ Recomendado: entre 5% y 20%. El negocio retiene más del 80% del ingreso.
                    </div>
                </div>
            </div>

            <div style="margin-top:16px;">
                <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">Bono efectivo por rango del abuelo:</div>
                <table class="table" style="font-size:12px;">
                    <thead>
                        <tr>
                            <th>Rango</th>
                            <th>Bonus de rango</th>
                            <th>Fórmula</th>
                            <th id="th-bono-efectivo">Con @Model.PorcentajeAbueloComision% base y precio $@Model.Precio.ToString("N0")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>🟤 Cobre</td><td>0%</td>    <td>base × 1.00</td><td class="fila-efectivo" data-mult="1.00"></td></tr>
                        <tr><td>🟠 Bronce</td><td>+10%</td> <td>base × 1.10</td><td class="fila-efectivo" data-mult="1.10"></td></tr>
                        <tr><td>⚪ Plata</td><td>+20%</td>  <td>base × 1.20</td><td class="fila-efectivo" data-mult="1.20"></td></tr>
                        <tr><td>🟡 Oro</td><td>+40%</td>    <td>base × 1.40</td><td class="fila-efectivo" data-mult="1.40"></td></tr>
                        <tr><td>🔵 Platino</td><td>+60%</td><td>base × 1.60</td><td class="fila-efectivo" data-mult="1.60"></td></tr>
                        <tr><td>💎 Diamante</td><td>+80%</td><td>base × 1.80</td><td class="fila-efectivo" data-mult="1.80"></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* ── PDFs ─────────────────────────────────────────────────── *@
        <div class="card" style="margin-bottom:14px;">
            <div class="card-header">
                <span class="card-title">📄 Documentos digitales</span>
                <button type="button" onclick="agregarFila()" class="btn btn-secondary btn-sm">+ Agregar documento</button>
            </div>
            <div style="font-size:13px; color:var(--text-muted); margin-bottom:14px;">
                Subir nuevos archivos los agrega a la lista existente. Para eliminar uno usá el botón de la lista actual.
            </div>

            @* Documentos actuales *@
            @if (Model.Pdfs.Any())
            {
                <div style="margin-bottom:16px;">
                    <div style="font-size:12px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">Documentos actuales</div>
                    @foreach (var pdf in Model.Pdfs.OrderBy(p => p.Orden))
                    {
                        <div style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); margin-bottom:6px;">
                            <div style="display:flex; align-items:center; gap:10px; font-size:13px;">
                                <span style="color:var(--sky); font-weight:600;">@pdf.Orden.</span>
                                <span>@pdf.Nombre</span>
                                <a href="/@pdf.Url" target="_blank" style="color:var(--text-muted); font-size:12px;">Ver →</a>
                            </div>
                            <form method="post" action="/Administrador/EliminarPdf/@pdf.Id"
                                  onsubmit="return confirm('¿Eliminar el documento «@pdf.Nombre»?');"
                                  style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productoId" value="@Model.Id" />
                                <button type="submit" class="btn btn-danger btn-sm" style="padding:4px 10px; font-size:12px;">✕</button>
                            </form>
                        </div>
                    }
                </div>
            }

            @* Agregar nuevos *@
            <div style="font-size:12px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; margin-bottom:8px;">Agregar nuevos documentos</div>
            <div id="filas-pdf" style="display:flex; flex-direction:column; gap:10px;"></div>
            <button type="button" onclick="agregarFila()" class="btn btn-secondary btn-sm" style="margin-top:10px; width:100%; justify-content:center;">
                + Agregar documento
            </button>
        </div>

        <script>
        function agregarFila() {
            const cont = document.getElementById('filas-pdf');
            const fila = document.createElement('div');
            fila.style.cssText = 'display:grid; grid-template-columns:1fr 1fr auto; gap:10px; align-items:end; background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); padding:12px;';
            fila.innerHTML = `
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-size:12px; margin-bottom:4px; display:block;">Nombre del documento</label>
                    <input type="text" name="nombresPdf" placeholder="Ej: Parte 3 — Limpia vidrios"
                           style="width:100%;" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-size:12px; margin-bottom:4px; display:block;">Archivo PDF</label>
                    <input type="file" name="archivosPdf" accept=".pdf"
                           style="background:var(--bg2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:7px 10px; width:100%; color:var(--text); font-size:12px;" />
                </div>
                <button type="button" onclick="this.closest('div[style]').remove()"
                        class="btn btn-danger btn-sm" style="height:38px;">✕</button>
            `;
            cont.appendChild(fila);
        }
        </script>

                <div style="display:flex; gap:10px;">
            <button type="submit" id="btn-submit" class="btn btn-primary">Guardar cambios</button>
            <a href="/Administrador/Productos" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

<script>
function fmt(n) {
    return '$' + n.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function actualizarCalculadora() {
    const precio = parseFloat(document.getElementById('inputPrecio')?.value) || 0;
    const pct    = parseFloat(document.getElementById('inputPorcentaje')?.value) || 0;

    const ingreso   = precio * 3;
    const premio    = precio;
    const bonoBase  = precio * pct / 100;
    const bonoMax   = bonoBase * 1.80;
    const margen    = ingreso - premio - bonoMax;
    const margenPct = ingreso > 0 ? (margen / ingreso * 100) : 0;

    document.getElementById('calc-ingreso').textContent   = fmt(ingreso);
    document.getElementById('calc-premio').textContent    = '−' + fmt(premio);
    document.getElementById('calc-bono').textContent      = '−' + fmt(bonoBase);
    document.getElementById('calc-bono-max').textContent  = '−' + fmt(bonoMax);
    document.getElementById('calc-margen').textContent    = fmt(margen);
    document.getElementById('calc-margen-pct').textContent = margenPct.toFixed(1) + '%';

    const elMargen = document.getElementById('calc-margen');
    elMargen.style.color = margen < 0 ? 'var(--red)' : margen < precio * 0.5 ? 'var(--amber)' : 'var(--green)';

    document.querySelectorAll('.fila-efectivo').forEach(td => {
        td.textContent = fmt(bonoBase * parseFloat(td.dataset.mult));
    });

    const thEfectivo = document.getElementById('th-bono-efectivo');
    if (thEfectivo) thEfectivo.textContent = `Con ${pct}% base y precio ${fmt(precio)}`;

    const badge    = document.getElementById('badge-zona');
    const msgAdv   = document.getElementById('msg-advertencia');
    const msgBlock = document.getElementById('msg-bloqueado');
    const zonaInfo = document.getElementById('zona-info');
    const btnSubmit= document.getElementById('btn-submit');

    msgAdv.style.display = msgBlock.style.display = 'none';

    if (pct > 66) {
        badge.className = 'badge badge-danger'; badge.textContent = '🚫 Bloqueado';
        msgBlock.style.display = 'block';
        zonaInfo.style.cssText += ';background:rgba(239,68,68,0.08);border-color:rgba(239,68,68,0.3);color:#FCA5A5';
        zonaInfo.textContent = '🚫 Límite superado. Con este porcentaje el negocio puede tener pérdidas. Máximo: 66%.';
        if (btnSubmit) btnSubmit.disabled = true;
    } else if (pct > 30) {
        badge.className = 'badge badge-warning'; badge.textContent = '⚠️ Zona agresiva';
        msgAdv.style.display = 'block';
        zonaInfo.style.cssText += ';background:rgba(245,158,11,0.08);border-color:rgba(245,158,11,0.3);color:#FCD34D';
        zonaInfo.textContent = `⚠️ Zona agresiva. Margen mínimo: ${margenPct.toFixed(0)}%. Asegurate de que el volumen lo justifique.`;
        if (btnSubmit) btnSubmit.disabled = false;
    } else {
        badge.className = 'badge badge-success'; badge.textContent = '✅ Zona segura';
        zonaInfo.style.cssText += ';background:rgba(34,197,94,0.08);border-color:rgba(34,197,94,0.2);color:#4ADE80';
        zonaInfo.textContent = `✅ El negocio retiene el ${margenPct.toFixed(0)}% del ingreso como margen mínimo.`;
        if (btnSubmit) btnSubmit.disabled = false;
    }
}

document.addEventListener('DOMContentLoaded', actualizarCalculadora);
</script>
