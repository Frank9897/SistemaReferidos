@* DetalleUsuario.cshtml — Views/Administrador/DetalleUsuario.cshtml *@
@model RedGenealogica.Web.Models.Usuario
@using RedGenealogica.Web.Enumeraciones
@{
    ViewData["Title"] = "Detalle de usuario";
    var referidos  = ViewBag.Referidos  as List<RedGenealogica.Web.Models.Referido>  ?? new();
    var movimientos= ViewBag.Movimientos as List<RedGenealogica.Web.Models.MovimientoPuntos> ?? new();
    var pagos      = ViewBag.Pagos      as List<RedGenealogica.Web.Models.Pago>      ?? new();
    var rangoClass = "rango-" + Model.TipoRangoActual.ToString().ToLower();
}

<div class="admin-tabs">
    <a href="/Administrador" class="admin-tab active">Dashboard</a>
    <a href="/Administrador/Usuarios" class="admin-tab">Usuarios</a>
    <a href="/Administrador/Productos" class="admin-tab">Productos</a>
    <a href="/Administrador/Retiros" class="admin-tab">Retiros</a>
    <a href="/Administrador/Configuracion" class="admin-tab">Configuración</a>
    <a href="/Administrador/Finanzas" class="tab-btn @(ViewData["Title"]?.ToString() == "Finanzas" ? "active" : "")">
    💰 Finanzas
    </a>
    <a href="/Administrador/Arbol" class="admin-tab">Árbol global</a>
</div>

<!-- HEADER USUARIO -->
<div class="card" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;">
    <div>
        <div class="titulo-principal">@Model.Nombres @Model.Apellidos</div>
        <div style="color:var(--text-muted); font-size:14px; margin-top:2px;">@Model.Email</div>
        <div style="color:var(--text-muted); font-size:12px; margin-top:4px;">
            CBU/Alias: <strong style="color:var(--text);">
                @(string.IsNullOrEmpty(Model.CbuAlias) ? "Sin configurar" : Model.CbuAlias)
            </strong>
        </div>
        <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap;">
            <span class="badge-rango @rangoClass">@Model.TipoRangoActual</span>
            @{
                var estadoBadge = Model.EstadoUsuario switch {
                    EstadoUsuario.Activo     => "badge-success",
                    EstadoUsuario.Pendiente  => "badge-warning",
                    EstadoUsuario.Suspendido => "badge-danger",
                    _ => "badge-muted"
                };
            }
            <span class="badge @estadoBadge">@Model.EstadoUsuario</span>
            <span class="badge badge-info">@Model.PuntosAcumulados pts</span>
        </div>
    </div>
    <div>
        <div style="font-size:12px; color:var(--text-muted); margin-bottom:4px;">Saldo disponible</div>
        <div style="font-family:'Space Grotesk',sans-serif; font-size:26px; font-weight:700; color:var(--green);">$@Model.SaldoDisponible.ToString("N2")</div>
        <div style="font-size:12px; color:var(--text-muted);">Pendiente: $@Model.SaldoPendienteRetiro.ToString("N2")</div>
    </div>
    <div class="acciones-inline">
        @if (Model.EstadoUsuario == EstadoUsuario.Activo)
        {
            <form asp-controller="Administrador" asp-action="Suspender" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('¿Suspender este usuario?')">🚫 Suspender</button>
            </form>
        }
        else if (Model.EstadoUsuario == EstadoUsuario.Suspendido)
        {
            <form asp-controller="Administrador" asp-action="Reactivar" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">✅ Reactivar</button>
            </form>
        }
        else if (Model.EstadoUsuario == EstadoUsuario.Pendiente)
        {
            <form asp-controller="Administrador" asp-action="ActivarManualmente"
                asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success"
                        onclick="return confirm('¿Activar manualmente? Solo hacelo si confirmaste el pago en MercadoPago.')">
                    ⚡ Activar manualmente
                </button>
            </form>
            <form asp-controller="Administrador" asp-action="Suspender" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"
                        onclick="return confirm('¿Suspender este usuario?')">🚫 Suspender</button>
            </form>
        }
        <a href="/Administrador/Usuarios" class="btn btn-secondary">← Volver</a>
    </div>
</div>

<!-- RESET CONTRASEÑA -->
        <div class="card">
            <div class="card-header">
                <span class="card-title">🔑 Resetear contraseña</span>
            </div>
            <div style="font-size:13px; color:var(--text-muted); margin-bottom:14px;">
                Usá esto cuando el usuario no pueda acceder a su cuenta. La nueva contraseña debe tener al menos 8 caracteres, una mayúscula y un número.
            </div>
            <form asp-controller="Administrador" asp-action="ResetearPassword" 
                asp-route-id="@Model.Id" method="post" 
                style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
                @Html.AntiForgeryToken()
                <div style="flex:1; min-width:200px;">
                    <label style="font-size:11px; color:var(--text-muted); display:block; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.4px;">
                        Nueva contraseña
                    </label>
                    <input name="nuevaPassword" type="text" required 
                        placeholder="Ej: NuevaClave123!" 
                        style="margin:0; width:100%;" />
                </div>
                <button type="submit" class="btn btn-secondary">Resetear contraseña</button>
            </form>
        </div>

<!-- REFERIDOS -->
@if (TempData["LinkPago"] != null)
{
    <div class="alert alert-success" style="margin-bottom:14px; word-break:break-all;">
        🔗 <strong>Link de pago para @TempData["LinkPagoNombre"]:</strong><br/>
        <span style="font-size:12px; color:var(--sky);" id="linkPagoTexto">@TempData["LinkPago"]</span>
        <button onclick="navigator.clipboard.writeText(document.getElementById('linkPagoTexto').innerText); this.innerText='✅ Copiado!'"
                class="btn btn-secondary btn-sm" style="margin-top:8px; display:block;">
            📋 Copiar link
        </button>
    </div>
}

<div class="card">
    <div class="card-header">
        <span class="card-title">👤 Referidos (@referidos.Count)</span>
    </div>

    @if (!referidos.Any())
    {
        <div class="empty-state"><div class="empty-icon">📭</div><p>Sin referidos registrados</p></div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Producto</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in referidos)
                {
                    var badgeClass = r.Estado switch {
                        EstadoReferido.Convertido => "badge-success",
                        EstadoReferido.Pagado     => "badge-info",
                        EstadoReferido.Cancelado  => "badge-danger",
                        _ => "badge-warning"
                    };
                    var estadoLabel = r.Estado switch {
                        EstadoReferido.Convertido => "Convertido",
                        EstadoReferido.Pagado     => "Pagado",
                        EstadoReferido.Cancelado  => "Cancelado",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td><strong>@r.NombreCompleto</strong></td>
                        <td style="font-size:12px; color:var(--text-muted);">@(r.CorreoElectronico ?? "—")</td>
                        <td style="font-size:12px;">@(r.Producto?.Nombre ?? "—")</td>
                        <td><span class="badge @badgeClass">@estadoLabel</span></td>
                        <td style="font-size:12px;">@r.FechaRegistro.ToString("dd/MM/yy")</td>
                        <td>
                            <div style="display:flex; gap:6px; flex-wrap:wrap;">

                                @* Pendiente: mostrar link de pago + confirmar pago manual *@
                                @if (r.Estado == EstadoReferido.Pendiente)
                                {
                                    <a asp-controller="Administrador" asp-action="LinkPagoReferido"
                                       asp-route-referidoId="@r.Id"
                                       class="btn btn-secondary btn-sm"
                                       title="Genera el link de MP para enviárselo al referido">
                                        🔗 Link pago
                                    </a>

                                    <form asp-controller="Administrador" asp-action="ConfirmarPagoReferido"
                                          asp-route-referidoId="@r.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm"
                                                onclick="return confirm('¿Confirmar el pago de @r.NombreCompleto manualmente? Solo hacelo si verificaste el pago en MercadoPago.')">
                                            ✅ Confirmar pago
                                        </button>
                                    </form>
                                }

                                @* Pagado: convertir a usuario si no fue convertido aún *@
                                @if (r.Estado == EstadoReferido.Pagado && r.UsuarioConvertidoId == null)
                                {
                                    <form asp-controller="Administrador" asp-action="ConvertirReferido"
                                          asp-route-referidoId="@r.Id" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm"
                                                onclick="return confirm('¿Convertir a @r.NombreCompleto en usuario del sistema?')">
                                            👤 Activar como usuario
                                        </button>
                                    </form>
                                }

                                @* Convertido: mostrar vínculo al usuario *@
                                @if (r.Estado == EstadoReferido.Convertido && r.UsuarioConvertidoId != null)
                                {
                                    <a asp-controller="Administrador" asp-action="DetalleUsuario"
                                       asp-route-id="@r.UsuarioConvertidoId"
                                       class="btn btn-secondary btn-sm">
                                        👁 Ver usuario
                                    </a>
                                }

                                @* Eliminar referido — disponible para cualquier estado menos Convertido *@
                                @if (r.Estado != EstadoReferido.Convertido)
                                {
                                    <form asp-controller="Administrador"
                                          asp-action="EliminarReferido"
                                          asp-route-referidoId="@r.Id"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"
                                                onclick="return confirm('¿Eliminar este referido? Esta acción no se puede deshacer.')">
                                            🗑 Eliminar
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- MOVIMIENTOS -->
<div class="card">
    <div class="card-header">
        <span class="card-title">📊 Últimos movimientos</span>
    </div>

    @if (!movimientos.Any())
    {
        <div class="empty-state"><div class="empty-icon">📭</div><p>Sin movimientos</p></div>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Fecha</th><th>Motivo</th><th>Nivel</th><th>Puntos</th><th>Monto</th></tr></thead>
            <tbody>
                @foreach (var m in movimientos)
                {
                    <tr>
                        <td>@m.FechaMovimiento.ToString("dd/MM/yy HH:mm")</td>
                        <td><strong>@m.Motivo</strong></td>
                        <td>@(m.Nivel > 0 ? "Nivel " + m.Nivel : "—")</td>
                        <td style="color:var(--sky);">+@m.CantidadPuntos</td>
                        <td style="color:var(--green);">@(m.Monto > 0 ? "$" + m.Monto.ToString("N2") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@await Html.PartialAsync("_BotonVolver")
