@* Productos.cshtml — Views/Administrador/Productos.cshtml *@
@model List<RedGenealogica.Web.Models.Producto>
@{ ViewData["Title"] = "Admin — Productos"; }

<div class="admin-tabs">
    <a href="/Administrador" class="admin-tab">Dashboard</a>
    <a href="/Administrador/Usuarios" class="admin-tab">Usuarios</a>
    <a href="/Administrador/Productos" class="admin-tab active">Productos</a>
    <a href="/Administrador/Retiros" class="admin-tab">Retiros</a>
    <a href="/Administrador/Configuracion" class="admin-tab">Configuración</a>
    <a href="/Administrador/Arbol" class="admin-tab">Árbol global</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success" style="margin-bottom:14px;">✅ @TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-bottom:14px;">⚠️ @TempData["Error"]</div>
}

<div class="card">
    <div class="card-header">
        <span class="card-title">📦 Productos (@Model.Count)</span>
        <a href="/Administrador/CrearProducto" class="btn btn-primary btn-sm">+ Nuevo producto</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <p>No hay productos aún. <a href="/Administrador/CrearProducto" style="color:var(--sky);">Creá el primero</a></p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Precio</th>
                    <th style="text-align:center;">% Abuelo</th>
                    <th style="text-align:center;">PDFs</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td data-label="Producto">
                            <strong>@p.Nombre</strong>
                            @if (!string.IsNullOrWhiteSpace(p.Descripcion))
                            {
                                <div style="font-size:12px; color:var(--text-muted);">
                                    @(p.Descripcion.Length > 60 ? p.Descripcion[..60] + "…" : p.Descripcion)
                                </div>
                            }
                        </td>
                        <td data-label="Precio" style="color:var(--sky); font-weight:600;">$@p.Precio.ToString("N0")</td>
                        <td data-label="% Bono">
                            @{ var pct = p.PorcentajeAbueloComision; var badgePct = pct > 30 ? "badge-warning" : "badge-info"; }
                            <span class="badge @badgePct">@pct%</span>
                        </td>
                        <td data-label="PDFs">
                            @{ int pdfs = p.Pdfs.Count; }
                            @if (pdfs > 0) { <span class="badge badge-success">@pdfs PDF@(pdfs > 1 ? "s" : "")</span> }
                            else           { <span class="badge badge-muted">Sin PDF</span> }
                        </td>
                        <td data-label="Stock">@(p.StockDisponible?.ToString() ?? "∞")</td>
                        <td data-label="Estado">
                            @if (p.Activo) { <span class="badge badge-success">Activo</span> }
                            else           { <span class="badge badge-danger">Inactivo</span> }
                        </td>
                        <td data-label="Acciones">
                            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                <a href="/Administrador/EditarProducto/@p.Id" class="btn btn-secondary btn-sm">Editar</a>
                                <form method="post" action="/Administrador/ToggleProducto/@p.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(p.Activo ? "btn-warning" : "btn-success")">
                                        @(p.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                                <form method="post" action="/Administrador/EliminarProducto/@p.Id"
                                    onsubmit="return confirm('¿Eliminar «@p.Nombre»?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
