@* Retiros.cshtml — Views/Administrador/Retiros.cshtml *@
@model List<RedGenealogica.Web.Models.SolicitudRetiro>
@using RedGenealogica.Web.Enumeraciones
@{ ViewData["Title"] = "Admin — Retiros"; }

<div class="admin-tabs">
    <a href="/Administrador/Usuarios" class="admin-tab">Usuarios</a>
    <a href="/Administrador/Productos" class="admin-tab">Productos</a>
    <a href="/Administrador/Retiros" class="admin-tab active">Retiros</a>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">💸 Gestión de retiros (@Model.Count)</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">✅</div>
            <p>No hay solicitudes de retiro</p>
        </div>
    }
    else
    {
        @foreach (var s in Model)
        {
            <div style="border:1px solid var(--border); border-radius:var(--radius); padding:18px; margin-bottom:12px;">
                <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
                    <div>
                        <div style="font-weight:600; font-size:15px;">@s.Usuario?.Nombres @s.Usuario?.Apellidos</div>
                            <div style="margin-top:6px;">
                                @switch (s.Estado)
                                {
                                    case EstadoRetiro.Pendiente:
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                        break;
                                    case EstadoRetiro.Aprobado:
                                        <span class="badge bg-info text-dark">Aprobado</span>
                                        break;
                                    case EstadoRetiro.Completado:
                                        <span class="badge bg-success">Completado</span>
                                        break;
                                    case EstadoRetiro.Rechazado:
                                        <span class="badge bg-danger">Rechazado</span>
                                        break;
                                }
                            </div>
                        <div style="font-size:12.5px; color:var(--text-muted);">@s.Usuario?.Email</div>
                        <a href="https://www.mercadopago.com.ar/"
                            target="_blank"
                            class="btn btn-primary"
                            style="width:100%; justify-content:center;">
                            💳 Abrir MercadoPago
                        </a>
                        <div style="margin-top:8px; display:flex; flex-direction:column; gap:6px;">
                            <span style="font-family:'Space Grotesk',sans-serif; font-size:22px; font-weight:700; color:var(--green);">
                                $@s.Monto.ToString("N2")
                            </span>

                            <div style="display:flex; flex-direction:column; gap:4px;">

                                <div style="font-size:12px;">
                                    Alias: <strong>@s.CbuAlias</strong>
                                </div>

                                <div style="display:flex; gap:6px; flex-wrap:wrap;">

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            onclick="copiarTexto('@Html.Raw(s.CbuAlias)')">
                                        📋 Alias
                                    </button>

                                    <button type="button"
                                            class="btn btn-secondary btn-sm"
                                            onclick="copiarTexto('@s.Monto.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)')">
                                        💰 Monto
                                    </button>

                                    <button type="button"
                                            class="btn btn-primary btn-sm"
                                            onclick="copiarTexto('Alias: @s.CbuAlias | Monto: @s.Monto.ToString("F2")')">
                                        📦 Todo
                                    </button>

                                </div>
                            </div>
                        </div>
                        <div style="font-size:12px; color:var(--text-muted);">
                            Solicitado: @s.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>

                    <div style="display:flex; flex-direction:column; gap:10px; min-width:260px;">

                        @if (s.Estado == EstadoRetiro.Pendiente)
                        {    
                            <div style="margin-top:6px; font-size:11px; color:#f59e0b;">
                                ⚠️ Pendiente de pago
                            </div>
                            <!-- Aprobar -->
                            <form method="post" action="/Administrador/AprobarRetiro/@s.Id">
                                @Html.AntiForgeryToken()
                                <div style="margin-bottom:6px;">
                                    <label style="font-size:11px;">Nota (opcional)</label>
                                    <input name="nota" placeholder="Ej: Validado OK" />
                                </div>
                                <button type="submit" class="btn btn-success" style="width:100%; justify-content:center;">
                                    ✓ Aprobar
                                </button>
                            </form>

                            <div style="text-align:center; font-size:11px; color:var(--text-dim);">— o —</div>

                            <!-- Rechazar -->
                            <form method="post" action="/Administrador/RechazarRetiro/@s.Id">
                                @Html.AntiForgeryToken()
                                <div style="margin-bottom:6px;">
                                    <label style="font-size:11px;">Motivo de rechazo *</label>
                                    <input name="motivo" required placeholder="Ej: Datos inválidos" />
                                </div>
                                <button type="submit" class="btn btn-danger" style="width:100%; justify-content:center;">
                                    ✕ Rechazar
                                </button>
                            </form>
                        }
                        else if (s.Estado == EstadoRetiro.Aprobado)
                        {
                            <!-- Completar -->
                            <form method="post" action="/Administrador/CompletarRetiro/@s.Id">
                                @Html.AntiForgeryToken()
                                <div style="margin-bottom:6px;">
                                    <label style="font-size:11px;">Referencia de transferencia *</label>
                                    <input name="referenciaTransferencia"
                                        required
                                        placeholder="Ej: 12345678901234" />

                                    <span style="font-size:11px; color:var(--text-muted);">
                                        Pegá el ID de la transferencia de MercadoPago
                                    </span>
                                </div>
                                <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
                                    💰 Completar pago
                                </button>
                            </form>
                        }
                        else
                        {
                            <div style="text-align:center; font-size:12px; color:var(--text-muted);">
                                Sin acciones disponibles
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    }
</div>
<script>
function copiarTexto(texto) {
    navigator.clipboard.writeText(texto).then(() => {
        console.log("Copiado:", texto);
    });
}
</script>