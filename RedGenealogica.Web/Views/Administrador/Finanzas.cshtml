@{ ViewData["Title"] = "Finanzas"; }

<div class="admin-tabs">
    <a href="/Administrador" class="admin-tab active">Dashboard</a>
    <a href="/Administrador/Usuarios" class="admin-tab">Usuarios</a>
    <a href="/Administrador/Productos" class="admin-tab">Productos</a>
    <a href="/Administrador/Retiros" class="admin-tab">Retiros</a>
    <a href="/Administrador/Configuracion" class="admin-tab">Configuración</a>
    <a href="/Administrador/Finanzas" class="tab-btn @(ViewData["Title"]?.ToString() == "Finanzas" ? "active" : "")">
    💰 Finanzas
    </a>
    <a href="/Administrador/Arbol" class="admin-tab">Árbol global</a>
</div>

<div class="page-wide">
<h2 style="font-size:20px; margin-bottom:20px;">💰 Dashboard Financiero</h2>

@* ── Ingresos ── *@
<div class="card" style="margin-bottom:16px;">
    <div class="card-header"><span class="card-title">📈 Ingresos</span></div>
    <div class="grid" style="margin-top:12px;">
        <div class="metric-card green">
            <div class="metric-icon">💳</div>
            <div class="metric-value">$@((decimal)ViewBag.IngresoBruto).ToString("N0")</div>
            <div class="metric-label">Ingresos MercadoPago</div>
        </div>
        <div class="metric-card blue">
            <div class="metric-icon">🏦</div>
            <div class="metric-value">$@((decimal)ViewBag.IngresoManual).ToString("N0")</div>
            <div class="metric-label">Ingresos manuales</div>
        </div>
        <div class="metric-card purple">
            <div class="metric-icon">💰</div>
            <div class="metric-value">$@((decimal)ViewBag.IngresoTotal).ToString("N0")</div>
            <div class="metric-label">Ingreso total</div>
        </div>
    </div>
</div>

@* ── Costos ── *@
<div class="card" style="margin-bottom:16px;">
    <div class="card-header"><span class="card-title">📉 Costos</span></div>
    <div class="grid" style="margin-top:12px;">
        <div class="metric-card amber">
            <div class="metric-icon">🏢</div>
            <div class="metric-value">$@((decimal)ViewBag.ComisionMP).ToString("N0")</div>
            <div class="metric-label">Comisión MP (6.29%)</div>
        </div>
        <div class="metric-card cyan">
            <div class="metric-icon">🎁</div>
            <div class="metric-value">$@((decimal)ViewBag.PremiosSponsor).ToString("N0")</div>
            <div class="metric-label">Premios a sponsors</div>
        </div>
        <div class="metric-card amber">
            <div class="metric-icon">👴</div>
            <div class="metric-value">$@((decimal)ViewBag.BonosAbuelo).ToString("N0")</div>
            <div class="metric-label">Bonos al abuelo</div>
        </div>
    </div>
</div>

@* ── Margen ── *@
<div class="card" style="margin-bottom:16px;">
    <div class="card-header"><span class="card-title">📊 Margen neto</span></div>
    <div style="display:flex; gap:24px; flex-wrap:wrap; margin-top:12px;">
        <div>
            <div style="font-size:12px; color:var(--text-muted);">Costo total</div>
            <div style="font-size:20px; font-weight:700; color:var(--red);">-$@((decimal)ViewBag.CostoTotal).ToString("N0")</div>
        </div>
        <div>
            <div style="font-size:12px; color:var(--text-muted);">Margen neto estimado</div>
            <div style="font-size:28px; font-weight:700; color:var(--green);">$@((decimal)ViewBag.MargenNeto).ToString("N0")</div>
        </div>
        <div>
            <div style="font-size:12px; color:var(--text-muted);">Margen %</div>
            <div style="font-size:28px; font-weight:700; color:var(--sky);">@((decimal)ViewBag.MargenPct).ToString("N1")%</div>
        </div>
    </div>
</div>

@* ── Retiros ── *@
<div class="card" style="margin-bottom:16px;">
    <div class="card-header"><span class="card-title">🏧 Retiros</span></div>
    <div class="grid" style="margin-top:12px;">
        <div class="metric-card green">
            <div class="metric-icon">✅</div>
            <div class="metric-value">$@((decimal)ViewBag.TotalRetirado).ToString("N0")</div>
            <div class="metric-label">Total retirado</div>
        </div>
        <div class="metric-card amber">
            <div class="metric-icon">⏳</div>
            <div class="metric-value">$@((decimal)ViewBag.PendienteRetiro).ToString("N0")</div>
            <div class="metric-label">Pendiente de retiro</div>
        </div>
        <div class="metric-card blue">
            <div class="metric-icon">🔄</div>
            <div class="metric-value">$@((decimal)ViewBag.SaldoEnCirculacion).ToString("N0")</div>
            <div class="metric-label">Saldo en circulación</div>
        </div>
    </div>
</div>

@* ── Por producto ── *@
<div class="card">
    <div class="card-header"><span class="card-title">📦 Ingresos por producto</span></div>
    <table class="table" style="margin-top:12px;">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Ventas</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in (dynamic)ViewBag.PorProducto)
            {
                <tr>
                    <td>@p.Producto</td>
                    <td>@p.Cantidad</td>
                    <td style="color:var(--green);">$@((decimal)p.Total).ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>