@* MiContenido.cshtml — Views/Contento/MiContenido.cshtml *@
@model List<RedGenealogica.Web.Models.Producto>
@{ ViewData["Title"] = "Mi contenido"; }

<div class="section-title">📚 Mi contenido</div>
<div class="section-subtitle">Productos que adquiriste — accedé a los PDFs en cualquier momento</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-error" style="margin-bottom:14px;">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p style="color:var(--text-muted);">
                Aún no tenés contenido desbloqueado.<br>
                Cuando completes el pago de un producto, aparecerá acá.
            </p>
        </div>
    </div>
}
else
{
    <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;">
        @foreach (var p in Model)
        {
            <div class="card" style="margin-bottom:0; display:flex; flex-direction:column; gap:12px;">
                @if (!string.IsNullOrEmpty(p.ImagenUrl))
                {
                    <img src="@p.ImagenUrl" alt="@p.Nombre"
                         style="width:100%; height:160px; object-fit:cover; border-radius:var(--radius-sm); margin-bottom:4px;" />
                }
                else
                {
                    <div style="width:100%; height:100px; background:var(--bg3); border-radius:var(--radius-sm); display:flex; align-items:center; justify-content:center; font-size:32px;">
                        📄
                    </div>
                }

                <div>
                    <div style="font-weight:600; font-size:15px; margin-bottom:4px;">@p.Nombre</div>
                    @if (!string.IsNullOrEmpty(p.Descripcion))
                    {
                        <div style="font-size:13px; color:var(--text-muted);">@p.Descripcion</div>
                    }
                </div>

                @{
                    int cantPdfs = p.Pdfs.Count;
                }
                <div style="font-size:12px; color:var(--text-muted);">
                    @cantPdfs documento@(cantPdfs != 1 ? "s" : "") disponible@(cantPdfs != 1 ? "s" : "")
                </div>

                <a href="/Contento/VerProducto/@p.Id" class="btn btn-primary" style="width:100%; justify-content:center; margin-top:auto;">
                    📖 Ver contenido
                </a>
            </div>
        }
    </div>
}
