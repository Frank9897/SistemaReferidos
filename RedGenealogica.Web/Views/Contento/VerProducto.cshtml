@* VerProducto.cshtml *@
@model RedGenealogica.Web.Models.Producto
@{ 
    ViewData["Title"] = Model.Nombre;
    var pdfs = Model.Pdfs.OrderBy(p => p.Orden).ToList();
}

<div style="max-width:900px; margin:0 auto;">

    <div style="margin-bottom:20px; display:flex; align-items:center; gap:12px;">
        <a href="/Contento/MiContenido" style="color:var(--text-muted); font-size:13px;">← Mi contenido</a>
        <span style="color:var(--text-dim);">/</span>
        <span style="font-size:13px; color:var(--text-muted);">@Model.Nombre</span>
    </div>

    <div class="section-title">@Model.Nombre</div>
    @if (!string.IsNullOrEmpty(Model.Descripcion))
    {
        <div class="section-subtitle" style="margin-bottom:24px;">@Model.Descripcion</div>
    }

    @if (!pdfs.Any())
    {
        <div class="card">
            <div class="empty-state">
                <div class="empty-icon">🔧</div>
                <p style="color:var(--text-muted);">El administrador aún no subió los documentos de este producto.</p>
            </div>
        </div>
    }
    else
    {
        @* Índice de documentos *@
        <div class="card" style="margin-bottom:20px;">
            <div class="card-header">
                <span class="card-title">📚 Documentos disponibles (@pdfs.Count)</span>
            </div>
            <div style="display:flex; flex-direction:column; gap:6px;">
                @foreach (var pdf in pdfs)
                {
                    <a href="#pdf-@pdf.Id"
                       style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px; background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); font-size:13px; color:var(--text); text-decoration:none; transition:border-color 0.15s;"
                       onmouseover="this.style.borderColor='var(--border-hover)'"
                       onmouseout="this.style.borderColor='var(--border)'">
                        <span>
                            <span style="color:var(--sky); margin-right:8px; font-weight:600;">@pdf.Orden.</span>
                            @pdf.Nombre
                        </span>
                        <span style="color:var(--text-muted); font-size:12px;">Ver ↓</span>
                    </a>
                }
            </div>
        </div>

        @* Visor por cada PDF *@
        @for (int i = 0; i < pdfs.Count; i++)
        {
            var pdf = pdfs[i];
            var visorIdx = i + 1;
            <div class="card" style="margin-bottom:20px;" id="pdf-@pdf.Id">
                <div class="card-header">
                    <span class="card-title">
                        <span style="color:var(--sky);">@pdf.Orden.</span> @pdf.Nombre
                    </span>
                    <a href="/Contento/DescargarPdf/@pdf.Id"
                       class="btn btn-secondary btn-sm" download>
                        ⬇️ Descargar
                    </a>
                </div>
                <div style="background:var(--bg3); border-radius:var(--radius-sm); overflow:hidden;">
                    <div id="loading-@visorIdx" style="padding:40px; text-align:center; color:var(--text-muted); font-size:13px;">
                        Cargando documento...
                    </div>
                    <canvas id="canvas-@visorIdx" style="width:100%; display:none;"></canvas>
                    <div id="controls-@visorIdx" style="display:none; align-items:center; justify-content:center; gap:16px; padding:12px; background:var(--surface); border-top:1px solid var(--border);">
                        <button onclick="cambiarPag(@visorIdx, -1)" class="btn btn-secondary btn-sm">← Anterior</button>
                        <span id="info-@visorIdx" style="font-size:13px; color:var(--text-muted);"></span>
                        <button onclick="cambiarPag(@visorIdx, 1)" class="btn btn-secondary btn-sm">Siguiente →</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

const visorState = {};

async function cargarPdf(idx, url) {
    try {
        const pdf = await pdfjsLib.getDocument('/' + url).promise;
        visorState[idx] = { pdf, pagina: 1, total: pdf.numPages };
        await renderPag(idx);
        document.getElementById('canvas-' + idx).style.display = 'block';
        document.getElementById('controls-' + idx).style.display = 'flex';
        document.getElementById('loading-' + idx).style.display = 'none';
    } catch(e) {
        document.getElementById('loading-' + idx).textContent = 'Error al cargar el documento.';
    }
}

async function renderPag(idx) {
    const { pdf, pagina } = visorState[idx];
    const canvas = document.getElementById('canvas-' + idx);
    const ctx = canvas.getContext('2d');
    const page = await pdf.getPage(pagina);
    const scale = canvas.parentElement.clientWidth / page.getViewport({ scale: 1 }).width;
    const vp = page.getViewport({ scale });
    canvas.width = vp.width;
    canvas.height = vp.height;
    await page.render({ canvasContext: ctx, viewport: vp }).promise;
    document.getElementById('info-' + idx).textContent =
        'Página ' + pagina + ' de ' + visorState[idx].total;
}

async function cambiarPag(idx, delta) {
    const s = visorState[idx];
    const nueva = s.pagina + delta;
    if (nueva < 1 || nueva > s.total) return;
    s.pagina = nueva;
    await renderPag(idx);
}

document.addEventListener('DOMContentLoaded', () => {
@{ int _i = 0; }
@foreach (var pdf in pdfs)
{
    _i++;
    @:    cargarPdf(@_i, '@pdf.Url');
}
});
</script>
