@* VerProducto.cshtml *@
@model RedGenealogica.Web.Models.Producto
@{
    ViewData["Title"] = Model.Nombre;
    var pdfs = Model.Pdfs.OrderBy(p => p.Orden).ToList();
}

<style>
/* ── Visor container ── */
.pdf-visor {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-bottom: 0;
}

/* ── Barra lateral izquierda (navegación) ── */
.pdf-layout {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    grid-template-rows: auto 1fr auto;
    min-height: 520px;
}

/* Columna nav izquierda */
.pdf-nav-left, .pdf-nav-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    gap: 8px;
    padding: 8px 4px;
    border-right: 1px solid var(--border);
}
.pdf-nav-right { border-right: none; border-left: 1px solid var(--border); }

/* Botón de navegación lateral */
.pdf-nav-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 16px;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
}
.pdf-nav-btn:hover:not(:disabled) { border-color: var(--border-hover); color: var(--sky); background: var(--bg3); }
.pdf-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }

/* Indicador de página en lateral */
.pdf-pag-info {
    font-size: 10px;
    color: var(--text-dim);
    text-align: center;
    line-height: 1.3;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
}

/* ── Toolbar superior ── */
.pdf-toolbar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
}
.pdf-tb-sep {
    width: 1px; height: 18px;
    background: var(--border);
    margin: 0 4px; flex-shrink: 0;
}
.pdf-tb-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 9px;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 11.5px;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
}
.pdf-tb-btn:hover { border-color: var(--border-hover); color: var(--sky); }
.pdf-tb-btn.on { background: rgba(56,189,248,0.1); border-color: rgba(56,189,248,0.3); color: var(--sky); }

.pdf-pag-input {
    width: 38px;
    text-align: center;
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-size: 11.5px;
    padding: 4px 4px;
}
.pdf-pag-input:focus { outline: none; border-color: var(--sky); }
.pdf-zoom-label {
    font-size: 11px;
    color: var(--text-muted);
    min-width: 34px;
    text-align: center;
}

/* ── Área de render ── */
.pdf-canvas-area {
    grid-column: 2 / 3;
    overflow: auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 16px;
    background: #111827;
    gap: 12px;
}
.pdf-canvas-wrap { box-shadow: 0 4px 20px rgba(0,0,0,0.6); flex-shrink: 0; }
.pdf-canvas-wrap canvas { display: block; }

/* ── Status bar ── */
.pdf-status {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 14px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    font-size: 11px;
    color: var(--text-dim);
}

/* ── Fullscreen ── */
.pdf-visor:fullscreen .pdf-canvas-area {
    max-height: calc(100vh - 90px);
}

/* ── Responsive ── */
@@media (max-width: 600px) {
    .pdf-layout { grid-template-columns: 36px 1fr 36px; }
    .pdf-nav-btn { width: 28px; height: 28px; font-size: 13px; }
    .pdf-toolbar { gap: 3px; padding: 6px 8px; }
    .pdf-tb-btn { padding: 3px 7px; font-size: 11px; }
}
</style>

<div style="max-width:960px; margin:0 auto;">

    <div style="margin-bottom:20px; display:flex; align-items:center; gap:12px;">
        <a href="/Contento/MiContenido" style="color:var(--text-muted); font-size:13px;">← Mi contenido</a>
        <span style="color:var(--text-dim);">/</span>
        <span style="font-size:13px; color:var(--text-muted);">@Model.Nombre</span>
    </div>

    <div class="section-title">@Model.Nombre</div>
    @if (!string.IsNullOrEmpty(Model.Descripcion))
    {
        <div class="section-subtitle" style="margin-bottom:24px;">@Model.Descripcion</div>
    }

    @if (!pdfs.Any())
    {
        <div class="card">
            <div class="empty-state">
                <div class="empty-icon">🔧</div>
                <p style="color:var(--text-muted);">El administrador aún no subió los documentos.</p>
            </div>
        </div>
    }
    else
    {
        @* Índice *@
        <div class="card" style="margin-bottom:20px;">
            <div class="card-header"><span class="card-title">📚 Documentos (@pdfs.Count)</span></div>
            <div style="display:flex; flex-direction:column; gap:6px;">
                @foreach (var pdf in pdfs)
                {
                    <a href="#pdf-@pdf.Id"
                       style="display:flex; align-items:center; justify-content:space-between; padding:10px 14px;
                              background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm);
                              font-size:13px; color:var(--text); text-decoration:none; transition:border-color 0.15s;"
                       onmouseover="this.style.borderColor='var(--border-hover)'"
                       onmouseout="this.style.borderColor='var(--border)'">
                        <span>
                            <span style="color:var(--sky); margin-right:8px; font-weight:600;">@pdf.Orden.</span>
                            @pdf.Nombre
                        </span>
                        <span style="color:var(--text-muted); font-size:12px;">Ver ↓</span>
                    </a>
                }
            </div>
        </div>

        @* Visor por cada PDF *@
        @for (int i = 0; i < pdfs.Count; i++)
        {
            var pdf = pdfs[i];
            var idx = i + 1;

            <div style="margin-bottom:28px;" id="pdf-@pdf.Id">

                @* Header con título y descarga *@
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
                    <div style="font-size:15px; font-weight:600;">
                        <span style="color:var(--sky);">@pdf.Orden.</span> @pdf.Nombre
                    </div>
                    <button onclick="descargarPdf('/Contento/DescargarPdf/@pdf.Id','@pdf.Nombre')"
                            class="btn btn-secondary btn-sm">
                        ⬇️ Descargar PDF
                    </button>
                </div>

                <div class="pdf-visor" id="visor-@idx">
                    @* ── Toolbar ── *@
                    <div class="pdf-toolbar">

                        @* Página *@
                        <span style="font-size:11px; color:var(--text-muted);">Pág.</span>
                        <input class="pdf-pag-input" id="pinput-@idx" type="number" min="1" value="1"
                               onchange="irA(@idx,this.value)"
                               onkeydown="if(event.key==='Enter')irA(@idx,this.value)" />
                        <span id="ptotal-@idx" class="pdf-zoom-label">/ —</span>

                        <div class="pdf-tb-sep"></div>

                        @* Zoom *@
                        <button class="pdf-tb-btn" onclick="zoom(@idx,-0.25)" title="Alejar">−</button>
                        <span id="zlabel-@idx" class="pdf-zoom-label">100%</span>
                        <button class="pdf-tb-btn" onclick="zoom(@idx,0.25)" title="Acercar">+</button>
                        <button class="pdf-tb-btn" onclick="ajustarAncho(@idx)" title="Ajustar ancho">↔</button>
                        <button class="pdf-tb-btn" onclick="ajustarPagina(@idx)" title="Ver página completa">⊡</button>

                        <div class="pdf-tb-sep"></div>

                        @* Vista y fullscreen *@
                        <button class="pdf-tb-btn" id="btn2p-@idx" onclick="toggleDoble(@idx)" title="Vista doble página">⊞ 2 págs</button>
                        <button class="pdf-tb-btn" id="btnfs-@idx" onclick="toggleFull(@idx)" title="Pantalla completa">⛶ Full</button>
                    </div>

                    @* ── Layout con botones laterales ── *@
                    <div class="pdf-layout">

                        @* Nav izquierda *@
                        <div class="pdf-nav-left">
                            <button class="pdf-nav-btn" onclick="irPrimera(@idx)" title="Primera página">⏮</button>
                            <button class="pdf-nav-btn" id="btn-prev-@idx" onclick="nav(@idx,-1)" title="Anterior">◀</button>
                            <span class="pdf-pag-info" id="pinfo-@idx">—</span>
                        </div>

                        @* Área canvas *@
                        <div class="pdf-canvas-area" id="carea-@idx">
                            <div id="loading-@idx" style="display:flex; align-items:center; gap:10px; color:var(--text-muted); font-size:13px; padding:60px 0;">
                                <div style="width:22px;height:22px;border:2px solid var(--border);border-top-color:var(--sky);border-radius:50%;animation:_spin 0.8s linear infinite;"></div>
                                Cargando...
                            </div>
                            <div class="pdf-canvas-wrap" id="cwrap-a-@idx" style="display:none;"><canvas id="cv-a-@idx"></canvas></div>
                            <div class="pdf-canvas-wrap" id="cwrap-b-@idx" style="display:none;"><canvas id="cv-b-@idx"></canvas></div>
                        </div>

                        @* Nav derecha *@
                        <div class="pdf-nav-right">
                            <button class="pdf-nav-btn" id="btn-next-@idx" onclick="nav(@idx,1)" title="Siguiente">▶</button>
                            <button class="pdf-nav-btn" onclick="irUltima(@idx)" title="Última página">⏭</button>
                        </div>
                    </div>

                    @* Status bar *@
                    <div class="pdf-status">
                        <span id="stxt-@idx">—</span>
                        <span id="szoom-@idx">—</span>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
@@keyframes _spin { to { transform: rotate(360deg); } }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc =
    'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

// Estado por visor — cada visor es completamente independiente
const VS = {};

// ── Cargar PDF ────────────────────────────────────────────────────
async function cargarPdf(idx, url) {
    try {
        const pdf = await pdfjsLib.getDocument('/Administrador/ServirPdf?ruta=' + encodeURIComponent(url)).promise;
        VS[idx] = { pdf, pag: 1, zoom: 1.0, doble: false };

        document.getElementById('loading-' + idx).style.display = 'none';
        document.getElementById('cwrap-a-' + idx).style.display = 'block';
        document.getElementById('ptotal-' + idx).textContent = '/ ' + pdf.numPages;
        document.getElementById('pinput-' + idx).max = pdf.numPages;

        await ajustarAncho(idx);   // zoom inicial = ajustar al ancho
        await render(idx);
    } catch(e) {
        document.getElementById('loading-' + idx).textContent = 'Error al cargar el documento.';
        console.error('PDF ' + idx + ':', e);
    }
}

// ── Render — cada visor usa solo sus propios elementos ────────────
async function render(idx) {
    const s = VS[idx];
    if (!s) return;

    await renderCanvas(idx, 'a', s.pag);

    if (s.doble && s.pag + 1 <= s.pdf.numPages) {
        document.getElementById('cwrap-b-' + idx).style.display = 'block';
        await renderCanvas(idx, 'b', s.pag + 1);
    } else {
        document.getElementById('cwrap-b-' + idx).style.display = 'none';
    }

    // Actualizar controles de ESTE visor
    const total = s.pdf.numPages;
    const pct   = Math.round(s.zoom * 100);

    document.getElementById('pinput-' + idx).value     = s.pag;
    document.getElementById('zlabel-' + idx).textContent = pct + '%';
    document.getElementById('szoom-'  + idx).textContent = pct + '%';

    const pagFin = s.doble ? Math.min(s.pag + 1, total) : s.pag;
    const txt = s.doble && pagFin > s.pag
        ? `Páginas ${s.pag}–${pagFin} de ${total}`
        : `Página ${s.pag} de ${total}`;

    document.getElementById('stxt-'  + idx).textContent = txt;
    document.getElementById('pinfo-' + idx).textContent = `${s.pag}/${total}`;

    // Botones prev/next
    const btnP = document.getElementById('btn-prev-' + idx);
    const btnN = document.getElementById('btn-next-' + idx);
    if (btnP) btnP.disabled = s.pag <= 1;
    if (btnN) btnN.disabled = s.doble
        ? s.pag + 1 >= total
        : s.pag >= total;
}

async function renderCanvas(idx, lado, numPag) {
    const s = VS[idx];
    const canvas = document.getElementById('cv-' + lado + '-' + idx);
    if (!canvas) return;

    const ctx  = canvas.getContext('2d');
    const page = await s.pdf.getPage(numPag);
    const dpr  = window.devicePixelRatio || 1;
    const vp   = page.getViewport({ scale: s.zoom * dpr });

    canvas.width  = vp.width;
    canvas.height = vp.height;
    canvas.style.width  = (vp.width  / dpr) + 'px';
    canvas.style.height = (vp.height / dpr) + 'px';

    await page.render({ canvasContext: ctx, viewport: vp }).promise;
}

// ── Navegación ────────────────────────────────────────────────────
async function nav(idx, delta) {
    const s = VS[idx];
    if (!s) return;
    const paso  = s.doble ? 2 : 1;
    const nueva = s.pag + delta * paso;
    if (nueva < 1 || nueva > s.pdf.numPages) return;
    s.pag = nueva;
    await render(idx);
}

async function irA(idx, val) {
    const s = VS[idx];
    if (!s) return;
    s.pag = Math.max(1, Math.min(parseInt(val) || 1, s.pdf.numPages));
    await render(idx);
}

async function irPrimera(idx) {
    const s = VS[idx]; if (!s) return;
    s.pag = 1; await render(idx);
}

async function irUltima(idx) {
    const s = VS[idx]; if (!s) return;
    s.pag = s.pdf.numPages; await render(idx);
}

// ── Zoom ──────────────────────────────────────────────────────────
async function zoom(idx, delta) {
    const s = VS[idx]; if (!s) return;
    s.zoom = Math.max(0.25, Math.min(4.0, s.zoom + delta));
    await render(idx);
}

async function ajustarAncho(idx) {
    const s = VS[idx]; if (!s) return;
    const area  = document.getElementById('carea-' + idx);
    const page  = await s.pdf.getPage(1);
    const vp1   = page.getViewport({ scale: 1 });
    const ancho = s.doble
        ? (area.clientWidth - 60) / 2
        : area.clientWidth - 32;
    s.zoom = Math.max(0.25, ancho / vp1.width);
}

async function ajustarPagina(idx) {
    const s = VS[idx]; if (!s) return;
    const area = document.getElementById('carea-' + idx);
    const page = await s.pdf.getPage(s.pag);
    const vp1  = page.getViewport({ scale: 1 });
    const zx   = (area.clientWidth  - 32) / vp1.width;
    const zy   = (area.clientHeight - 32) / vp1.height;
    s.zoom = Math.max(0.25, Math.min(zx, zy));
    await render(idx);
}

// ── Vista doble ───────────────────────────────────────────────────
async function toggleDoble(idx) {
    const s = VS[idx]; if (!s) return;
    s.doble = !s.doble;
    document.getElementById('btn2p-' + idx).classList.toggle('on', s.doble);
    if (s.doble && s.pag % 2 === 0 && s.pag > 1) s.pag--;
    await ajustarAncho(idx);
    await render(idx);
}

// ── Pantalla completa ─────────────────────────────────────────────
function toggleFull(idx) {
    const visor = document.getElementById('visor-' + idx);
    const btn   = document.getElementById('btnfs-' + idx);

    if (!document.fullscreenElement) {
        visor.requestFullscreen().then(() => {
            btn.textContent = '✕ Salir';
            btn.classList.add('on');
            ajustarAncho(idx).then(() => render(idx));
        }).catch(() => {});
    } else {
        document.exitFullscreen().then(() => {
            btn.textContent = '⛶ Full';
            btn.classList.remove('on');
            ajustarAncho(idx).then(() => render(idx));
        }).catch(() => {});
    }
}

document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) {
        document.querySelectorAll('[id^="btnfs-"]').forEach(b => {
            b.textContent = '⛶ Full';
            b.classList.remove('on');
        });
        Object.keys(VS).forEach(idx => {
            ajustarAncho(parseInt(idx)).then(() => render(parseInt(idx)));
        });
    }
});

// ── Teclado — opera sobre el visor más cercano al foco ───────────
// Cada visor registra su propio listener en su área de canvas
document.addEventListener('DOMContentLoaded', () => {
    Object.keys(VS).forEach(() => {});  // placeholder, listeners abajo

    document.querySelectorAll('[id^="carea-"]').forEach(area => {
        area.setAttribute('tabindex', '0');
        area.addEventListener('keydown', e => {
            const idx = parseInt(area.id.replace('carea-', ''));
            if (!VS[idx]) return;
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); nav(idx, 1); }
            else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); nav(idx, -1); }
            else if (e.key === '+' || e.key === '=') zoom(idx, 0.25);
            else if (e.key === '-') zoom(idx, -0.25);
            else if (e.key === 'Home') irPrimera(idx);
            else if (e.key === 'End')  irUltima(idx);
        });

        // Ctrl + rueda = zoom sobre ese visor
        area.addEventListener('wheel', e => {
            if (!e.ctrlKey) return;
            const idx = parseInt(area.id.replace('carea-', ''));
            e.preventDefault();
            zoom(idx, e.deltaY < 0 ? 0.25 : -0.25);
        }, { passive: false });
    });
});

// ── Descarga — forzar application/pdf vía fetch ──────────────────
// Esto previene que el servidor sirva el archivo como text/plain
async function descargarPdf(url, nombre) {
    try {
        const res  = await fetch(url);
        const blob = await res.blob();
        const obj  = URL.createObjectURL(new Blob([blob], { type: 'application/pdf' }));
        const a    = document.createElement('a');
        a.href     = obj;
        a.download = nombre + '.pdf';
        a.click();
        setTimeout(() => URL.revokeObjectURL(obj), 5000);
    } catch(e) {
        window.location.href = url;
    }
}

// ── Inicializar todos los visores ─────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
@{ int _i = 0; }
@foreach (var pdf in pdfs)
{
    _i++;
    @:    cargarPdf(@_i, '@pdf.Url');
}
});
</script>

@await Html.PartialAsync("_BotonVolver")
