@* Index.cshtml — Views/Genealogia/Index.cshtml *@
@{ ViewData["Title"] = "Árbol genealógico"; }
<div class="page-wide">
<div class="arbol-wrap">

  @* ============================================================
     BLOQUE MODIFICADO: toolbar tipo "nav"
     - Búsqueda alineada a la misma altura que los botones.
     - Acciones agrupadas para mantener una composición limpia.
     ============================================================ *@
  <div class="arbol-toolbar">
    <span class="arbol-titulo">🌳 Árbol genealógico</span>

    <div class="arbol-search" role="search" aria-label="Buscar usuario en el árbol">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input id="arbol-buscar" type="text" placeholder="Buscar usuario..." autocomplete="off" />
    </div>

    <div class="arbol-actions">
      <button class="arbol-btn" id="btn-expandir" type="button">⊕ Expandir</button>
      <button class="arbol-btn" id="btn-colapsar" type="button">⊖ Colapsar</button>
      <button class="arbol-btn" id="btn-centrar" type="button">⌖ Centrar</button>
      <button class="arbol-btn" id="btn-fullscreen" type="button">⛶ Full</button>
    </div>
  </div>

  @* Leyenda y ayuda visual: se mantiene arriba del canvas para reforzar lectura *@
  <div class="arbol-legend">
    <div class="legend-item"><div class="legend-dot" style="background:#A0522D"></div>Cobre</div>
    <div class="legend-item"><div class="legend-dot" style="background:#F97316"></div>Bronce</div>
    <div class="legend-item"><div class="legend-dot" style="background:#C0C0C0"></div>Plata</div>
    <div class="legend-item"><div class="legend-dot" style="background:#FFD700"></div>Oro</div>
    <div class="legend-item"><div class="legend-dot" style="background:#22D3EE"></div>Platino</div>
    <div class="legend-item"><div class="legend-dot" style="background:#60A5FA"></div>Diamante</div>
    <div class="legend-item"><div class="legend-dot" style="background:#475569"></div>Referido</div>
    <span class="arbol-hint">Click → expandir · Arrastrar → mover · Rueda → zoom</span>
  </div>

  @* Área de render del árbol *@
  <div id="arbol-svg-wrap">
    <div class="arbol-loading" id="arbol-loading">
      <div class="arbol-spinner"></div>
      <span>Cargando árbol...</span>
    </div>
  </div>
</div>

<div id="arbol-tooltip"></div>
</div>
@await Html.PartialAsync("_BotonVolver")

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script>
(function () {

  // ── Configuración del layout ────────────────────────────────────
  const R = 22;   // radio del nodo
  const VG = 110; // separación vertical entre niveles
  const HG = 60;  // separación horizontal entre nodos
  const DUR = 280; // duración de animaciones

  const DEFAULT_TREE_HEIGHT = '460px';

  const RANGO_COLOR = {
    Diamante: '#60A5FA', Platino: '#22D3EE', Oro: '#FFD700',
    Plata: '#C0C0C0', Bronce: '#F97316', Cobre: '#A0522D',
    Referido: '#475569'
  };

  const RANGO_ICON = {
    Diamante: '💎', Platino: '🔷', Oro: '🏆',
    Plata: '⚡', Bronce: '🔶', Cobre: '🔸', Referido: '👤'
  };

  // ── Estado ───────────────────────────────────────────────────────
  let root, svgEl, gEl, zoomBeh, searchTimer;
  const wrap = document.getElementById('arbol-svg-wrap');
  const tooltip = document.getElementById('arbol-tooltip');
  const arbolWrap = document.querySelector('.arbol-wrap');
  const btnFullscreen = document.getElementById('btn-fullscreen');
  const treeHost = document.getElementById('arbol-svg-wrap');

  // ── Carga inicial ────────────────────────────────────────────────
  fetch('/Genealogia/ObtenerArbol')
    .then(r => r.json())
    .then(data => {
      const loader = document.getElementById('arbol-loading');
      if (loader) loader.remove();
      init(data);
    })
    .catch(() => {
      const loader = document.getElementById('arbol-loading');
      if (loader) {
        loader.innerHTML = '<span style="color:var(--red)">Error al cargar el árbol</span>';
      }
    });

  // ── Inicialización de SVG y jerarquía D3 ────────────────────────
  function init(data) {
    svgEl = d3.select(wrap).append('svg')
      .attr('width', '100%')
      .attr('height', '100%');

    const defs = svgEl.append('defs');
    defs.append('linearGradient')
      .attr('id', 'lg')
      .attr('gradientUnits', 'userSpaceOnUse')
      .call(g => {
        g.append('stop').attr('offset', '0%').attr('stop-color', 'rgba(56,189,248,0.5)');
        g.append('stop').attr('offset', '100%').attr('stop-color', 'rgba(56,189,248,0.08)');
      });

    gEl = svgEl.append('g');

    zoomBeh = d3.zoom()
      .scaleExtent([0.1, 3])
      .on('zoom', e => gEl.attr('transform', e.transform));

    svgEl.call(zoomBeh).on('dblclick.zoom', null);

    root = d3.stratify().id(d => d.id).parentId(d => d.padreId)(data);
    root.x0 = 0;
    root.y0 = 0;

    // BLOQUE MODIFICADO: estado inicial del árbol
    // Deja el root con sus hijos directos visibles y colapsa cualquier nivel inferior.
    if (root.children) {
      root.children.forEach(c => {
        if (c.children) colapsar(c);
      });
    }

    update(root);
    centrar();
  }

  // ── Layout ────────────────────────────────────────────────────────
  function layout() {
    return d3.tree().nodeSize([HG + R * 2, VG]);
  }

  // ── Render principal ─────────────────────────────────────────────
  function update(src) {
    layout()(root);

    const nodes = root.descendants();
    const links = root.links();

    // LINKS: primero para que queden detrás de los nodos
    const link = gEl.selectAll('path.arbol-link')
      .data(links, d => d.target.id);

    const linkEnter = link.enter().insert('path', 'g')
      .attr('class', 'arbol-link')
      .attr('fill', 'none')
      .attr('stroke', 'rgba(56,189,248,0.25)')
      .attr('stroke-width', 1.2)
      .attr('d', () => linkPath(
        { x: src.x0 ?? 0, y: src.y0 ?? 0 },
        { x: src.x0 ?? 0, y: src.y0 ?? 0 }
      ));

    linkEnter.merge(link)
      .transition()
      .duration(DUR)
      .attr('d', d => linkPath(d.source, d.target));

    link.exit()
      .transition()
      .duration(DUR)
      .attr('d', () => linkPath({ x: src.x, y: src.y }, { x: src.x, y: src.y }))
      .remove();

    // NODOS: luego para quedar por encima de los links
    const node = gEl.selectAll('g.nodo-g')
      .data(nodes, d => d.id);

    const enter = node.enter().append('g')
      .attr('class', 'nodo-g')
      .attr('transform', () => `translate(${src.x0 ?? 0},${src.y0 ?? 0})`)
      .style('opacity', 0)
      .on('click', (e, d) => { e.stopPropagation(); toggleNodo(d); })
      .on('mouseenter', (e, d) => showTooltip(e, d))
      .on('mouseleave', () => hideTooltip());

    enter.append('circle')
      .attr('class', 'nodo-border')
      .attr('r', R + 3)
      .attr('fill', 'none')
      .attr('stroke', d => RANGO_COLOR[d.data.rango] || '#475569')
      .attr('stroke-width', 2)
      .attr('opacity', 0.6);

    enter.append('circle')
      .attr('class', 'nodo-circle')
      .attr('r', R)
      .attr('fill', '#0F172A')
      .attr('stroke', d => RANGO_COLOR[d.data.rango] || '#475569')
      .attr('stroke-width', 1.5);

    enter.append('text')
      .attr('class', 'nodo-icon')
      .attr('text-anchor', 'middle')
      .attr('y', 0)
      .attr('dominant-baseline', 'central')
      .style('font-size', '16px')
      .style('pointer-events', 'none')
      .text(d => RANGO_ICON[d.data.rango] || '👤');

    enter.append('text')
      .attr('class', 'nodo-nombre')
      .attr('text-anchor', 'middle')
      .attr('y', R + 14)
      .attr('fill', '#EAF0FF')
      .style('font-size', '10.5px')
      .style('font-weight', '600')
      .style('font-family', "'DM Sans', sans-serif")
      .style('pointer-events', 'none')
      .text(d => truncar(d.data.nombre, 12));

    enter.append('text')
      .attr('class', 'nodo-rango-label')
      .attr('text-anchor', 'middle')
      .attr('y', R + 26)
      .attr('fill', d => RANGO_COLOR[d.data.rango] || '#475569')
      .style('font-size', '9px')
      .style('pointer-events', 'none')
      .text(d => d.data.rango);

    // Toggle visual dentro del nodo (+ / −)
    const toggleG = enter.append('g')
      .attr('class', 'nodo-toggle')
      .attr('transform', `translate(0, ${R + 36})`)
      .on('click', (e, d) => { e.stopPropagation(); toggleNodo(d); });

    toggleG.append('circle')
      .attr('r', 7)
      .attr('fill', '#0F172A')
      .attr('stroke', '#38BDF8')
      .attr('stroke-width', 1.5);

    toggleG.append('text')
      .attr('text-anchor', 'middle')
      .attr('dominant-baseline', 'central')
      .attr('fill', '#38BDF8')
      .style('font-size', '12px')
      .style('pointer-events', 'none');

    // Hover glow suave
    enter
      .on('mouseenter.glow', function (e, d) {
        const color = RANGO_COLOR[d.data.rango] || '#475569';
        d3.select(this).select('.nodo-circle')
          .transition().duration(150)
          .attr('fill', '#1A2540')
          .style('filter', `drop-shadow(0 0 5px ${color}55)`);
        d3.select(this).select('.nodo-border')
          .transition().duration(150)
          .attr('opacity', 1)
          .attr('stroke-width', 2.5);
      })
      .on('mouseleave.glow', function () {
        d3.select(this).select('.nodo-circle')
          .transition().duration(150)
          .attr('fill', '#0F172A')
          .style('filter', null);
        d3.select(this).select('.nodo-border')
          .transition().duration(150)
          .attr('opacity', 0.6)
          .attr('stroke-width', 2);
      });

    const merged = enter.merge(node);

    merged.transition()
      .duration(DUR)
      .attr('transform', d => `translate(${d.x},${d.y})`)
      .style('opacity', 1);

    // Estado del toggle según si tiene hijos visibles u ocultos
    merged.select('.nodo-toggle text')
      .text(d => d.children ? '−' : d._children ? '+' : '');

    merged.select('.nodo-toggle')
      .style('display', d => (d.children || d._children) ? null : 'none');

    node.exit()
      .transition()
      .duration(DUR)
      .attr('transform', () => `translate(${src.x},${src.y})`)
      .style('opacity', 0)
      .remove();

    nodes.forEach(d => { d.x0 = d.x; d.y0 = d.y; });
  }

  // ── Conector ortogonal entre padre e hijo ─────────────────────────
  function linkPath(s, t) {
    const sy = s.y + R;
    const ty = t.y - R;
    const my = sy + (ty - sy) * 0.45;
    return `M${s.x},${sy} L${s.x},${my} L${t.x},${my} L${t.x},${ty}`;
  }

  // ── BLOQUE MODIFICADO: colapsado total del árbol ─────────────────
  function colapsar(d) {
    if (!d || !d.children) return;
    d._children = d.children;
    d._children.forEach(colapsar);
    d.children = null;
  }

  function expandirTodo(d) {
    if (!d) return;
    if (d._children) {
      d.children = d._children;
      d._children = null;
    }
    if (d.children) d.children.forEach(expandirTodo);
  }

  function toggleNodo(d) {
    if (d.children) {
      colapsar(d);
    } else if (d._children) {
      d.children = d._children;
      d._children = null;
    }
    update(d);
  }

  // ── Centrado del árbol ────────────────────────────────────────────
  function centrar() {
    if (!svgEl || !root) return;
    const W = wrap.clientWidth || 800;
    svgEl.transition().duration(400)
      .call(zoomBeh.transform, d3.zoomIdentity.translate(W / 2 - root.x, 60));
  }

  // ── Tooltip ───────────────────────────────────────────────────────
  function showTooltip(e, d) {
    const color = RANGO_COLOR[d.data.rango] || '#475569';
    const hijosCnt = (d.children ? d.children.length : 0) + (d._children ? d._children.length : 0);

    tooltip.innerHTML = `
      <div class="tt-name">${d.data.nombre}</div>
      <div class="tt-row"><span>Rango</span><span class="tt-val" style="color:${color}">${d.data.rango}</span></div>
      <div class="tt-row"><span>Estado</span><span class="tt-val">${d.data.estado || '—'}</span></div>
      <div class="tt-row"><span>Puntos</span><span class="tt-val" style="color:#38BDF8">${d.data.comision || 0}</span></div>
      ${hijosCnt > 0 ? `<div class="tt-row"><span>Referidos</span><span class="tt-val">${hijosCnt}</span></div>` : ''}
    `;

    tooltip.style.left = (e.clientX + 14) + 'px';
    tooltip.style.top = (e.clientY + 14) + 'px';
    tooltip.classList.add('show');
  }

  function hideTooltip() {
    tooltip.classList.remove('show');
  }

  // ── Búsqueda con debounce ─────────────────────────────────────────
  document.getElementById('arbol-buscar').addEventListener('input', function () {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => buscar(this.value.trim()), 300);
  });

  function buscar(q) {
    if (!root) return;

    gEl.selectAll('.nodo-circle').attr('fill', '#0F172A').style('filter', null);
    gEl.selectAll('.nodo-border').attr('opacity', 0.6).attr('stroke-width', 2);

    if (!q) return;

    const ql = q.toLowerCase();
    const encontrados = [];

    root.each(d => {
      if (d.data.nombre && d.data.nombre.toLowerCase().includes(ql)) {
        let anc = d.parent;
        while (anc) {
          if (anc._children) {
            anc.children = anc._children;
            anc._children = null;
          }
          anc = anc.parent;
        }
        encontrados.push(d);
      }
    });

    if (encontrados.length === 0) return;

    update(root);

    const primero = encontrados[0];
    const W = wrap.clientWidth || 800;
    const H = wrap.clientHeight || 460;
    svgEl.transition().duration(500)
      .call(zoomBeh.transform,
        d3.zoomIdentity.translate(W / 2 - primero.x, H / 2 - primero.y).scale(1)
      );

    setTimeout(() => {
      gEl.selectAll('g.nodo-g')
        .filter(d => d.data.nombre && d.data.nombre.toLowerCase().includes(ql))
        .each(function (d) {
          const color = RANGO_COLOR[d.data.rango] || '#38BDF8';
          d3.select(this).select('.nodo-circle')
            .attr('fill', '#1A3A5C')
            .style('filter', `drop-shadow(0 0 8px ${color}88)`);
          d3.select(this).select('.nodo-border')
            .attr('opacity', 1)
            .attr('stroke-width', 3);
        });
    }, 560);
  }

  // ── Toolbar actions ───────────────────────────────────────────────
  document.getElementById('btn-expandir').addEventListener('click', () => {
    if (!root) return;
    expandirTodo(root);
    update(root);
    setTimeout(centrar, DUR + 50);
  });

  // BLOQUE MODIFICADO: colapsar completo, dejando solo el nodo padre visible.
  document.getElementById('btn-colapsar').addEventListener('click', () => {
    if (!root) return;
    colapsar(root);
    update(root);
    setTimeout(centrar, DUR + 50);
  });

  document.getElementById('btn-centrar').addEventListener('click', centrar);

  // BLOQUE MODIFICADO: fullscreen sincronizado con fullscreenchange.
  // Soluciona el estado visual incorrecto al salir con ESC o desde el navegador.
  function syncFullscreenUI() {
    const isFullscreen = !!document.fullscreenElement;
    btnFullscreen.textContent = isFullscreen ? '✕ Salir' : '⛶ Full';
    btnFullscreen.classList.toggle('active', isFullscreen);
    treeHost.style.height = isFullscreen ? 'calc(100vh - 170px)' : DEFAULT_TREE_HEIGHT;

    if (root) {
      setTimeout(centrar, 180);
    }
  }

  btnFullscreen.addEventListener('click', async () => {
    try {
      if (!document.fullscreenElement) {
        await arbolWrap.requestFullscreen();
      } else {
        await document.exitFullscreen();
      }
    } catch (err) {
      console.error(err);
    }
  });

  document.addEventListener('fullscreenchange', syncFullscreenUI);

  // ── Resize responsive ─────────────────────────────────────────────
  if ('ResizeObserver' in window) {
    new ResizeObserver(() => { if (root) centrar(); }).observe(wrap);
  }

  // ── Pinch to zoom (mobile) ────────────────────────────────────────
  let pinchDist = 0;
  wrap.addEventListener('touchmove', e => {
    if (e.touches.length !== 2) return;
    e.preventDefault();
    const d = Math.hypot(
      e.touches[0].clientX - e.touches[1].clientX,
      e.touches[0].clientY - e.touches[1].clientY
    );
    if (pinchDist > 0) svgEl.call(zoomBeh.scaleBy, d / pinchDist);
    pinchDist = d;
  }, { passive: false });
  wrap.addEventListener('touchend', () => { pinchDist = 0; });

  // ── Helpers ──────────────────────────────────────────────────────
  function truncar(s, max) {
    return s && s.length > max ? s.slice(0, max) + '…' : (s || '');
  }

})();
</script>
