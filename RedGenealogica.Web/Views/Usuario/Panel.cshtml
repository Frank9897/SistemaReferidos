@model RedGenealogica.Web.ViewModels.PanelUsuarioViewModel
@using RedGenealogica.Web.Enumeraciones
@{ ViewData["Title"] = "Panel"; }

@{
    var rangoClass = "rango-" + Model.Usuario.TipoRangoActual.ToString().ToLower();
    var rangoIcono = Model.Usuario.TipoRangoActual switch {
        TipoRango.Cobre    => "🟤",
        TipoRango.Bronce   => "🟠",
        TipoRango.Plata    => "⚪",
        TipoRango.Oro      => "🟡",
        TipoRango.Platino  => "🔵",
        TipoRango.Diamante => "💎",
        _ => "⬜"
    };
}
<div class="page-wide">
<!-- HEADER -->
@if (ViewBag.Activado == true)
{
    <div class="alert alert-success" style="margin-bottom:18px;">
        🎉 Tu cuenta fue activada correctamente
    </div>
}
<div class="card" style="margin-bottom:18px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px;">
    <div>
        <div class="titulo-principal">Hola, @Model.Usuario.Nombres 👋</div>
        <div class="subtitulo" style="margin-top:4px;">Seguí construyendo tu red y subí de nivel</div>
        <div style="margin-top:10px;">
            <span class="badge-rango @rangoClass">@rangoIcono @Model.Usuario.TipoRangoActual</span>
            @if (Model.Usuario.EstadoUsuario == EstadoUsuario.Pendiente)
            {
                <span class="badge badge-warning" style="margin-left:8px;">Cuenta no activa</span>
            }
        </div>
    </div>
    <div class="acciones-inline">
        <a href="/Usuario/EditarPerfil" class="btn btn-secondary">⚙️ Editar perfil</a>
        <a href="/Referidos/Crear" class="btn btn-primary">+ Invitar referido</a>
        <a href="/Genealogia" class="btn btn-secondary">Ver árbol</a>
    </div>
</div>
            @if (Model.Usuario.EstadoUsuario == EstadoUsuario.Pendiente)
            {
                <div class="alert alert-warning" style="margin-bottom:18px;">
                    ⚠️ Tu cuenta aún no está activa.<br>
                    Pagá el producto para activar tu cuenta y empezar a referir.
                    <div style="margin-top:10px;">
                        <a href="/Pagos/PagarActivacion" class="btn btn-primary btn-sm">
                            💳 Activar mi cuenta
                        </a>
                    </div>
                </div>
            }
<!-- MÉTRICAS -->
<div class="grid">

    <!-- PREMIOS -->
    <div class="metric-card green">
        <div class="metric-icon">💰</div>
        <div class="metric-value">$@Model.Usuario.SaldoDisponible.ToString("N0")</div>
        <div class="metric-label">Premios acumulados</div>
    </div>

    <!-- CICLOS -->
    <div class="metric-card purple">
        <div class="metric-icon">🔁</div>
        <div class="metric-value">@Model.Usuario.CiclosCompletados</div>
        <div class="metric-label">Ciclos completados</div>
    </div>

    <!-- REFERIDOS ACTIVOS -->
    <div class="metric-card blue">
        <div class="metric-icon">👥</div>
        <div class="metric-value">@Model.TotalReferidosActivos</div>
        <div class="metric-label">Referidos activos</div>
    </div>

    <!-- REFERIDOS REGISTRADOS -->
    <div class="metric-card cyan">
        <div class="metric-icon">🧾</div>
        <div class="metric-value">@Model.TotalReferidosRegistrados</div>
        <div class="metric-label">Referidos registrados</div>
    </div>

    <!-- RANGO -->
    <div class="metric-card amber">
        <div class="metric-icon">🏆</div>
        <div class="metric-value">@Model.Usuario.TipoRangoActual</div>
        <div class="metric-label">Rango actual</div>
    </div>

</div>

<!-- SALDO + PROGRESO -->
<div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:18px;">

    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <span class="card-title">💵 Saldo disponible</span>
            <div style="font-size:11px; color:var(--text-muted); margin-top:6px;">
                Podés retirar este dinero cuando quieras
            </div>
            <a href="/Usuario/SolicitarRetiro" class="btn btn-success btn-sm">Retirar</a>
        </div>
        <div style="font-family:'Space Grotesk',sans-serif; font-size:32px; font-weight:700; color:var(--green);">
            $@Model.Usuario.SaldoDisponible.ToString("N2")
        </div>
        <div style="font-size:12px; color:var(--text-muted); margin-top:6px;">
            Pendiente de retiro: $@Model.Usuario.SaldoPendienteRetiro.ToString("N2")
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <span class="card-title">🎯 Progreso de ciclo</span>
        </div>

        <div class="progress-bar">
            <div class="progress-fill" style="width:@Model.ProgresoCiclo%"></div>
        </div>

        <div style="display:flex; justify-content:space-between; margin-top:8px; font-size:12px; color:var(--text-muted);">
            <span>@Model.ReferidosActuales / 3 referidos</span>
            @if (Model.ReferidosActuales > 0)
            {
                <span>Faltan @(3 - Model.ReferidosActuales)</span>
            }
            else if (Model.Usuario.CiclosCompletados > 0)
            {
                <span style="color:var(--green);">✔ Ciclo completado</span>
            }
            else
            {
                <span>Empezá tu primer ciclo</span>
            }
        </div>

        <div style="margin-top:8px; font-size:12px; color:var(--text-muted);">
            💰 Cada 3 referidos pagos obtenés un premio equivalente al valor del producto.
        </div>
    </div>
    
    
</div>

<!-- LINK DE REFERIDO -->
@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var linkRegistro = $"{baseUrl}/Autenticacion/Registro?codigo={Model.Usuario.CodigoReferido}";
    var nombreUsuario = $"{Model.Usuario.Nombres} {Model.Usuario.Apellidos}";
    var mensajeWa = Uri.EscapeDataString($"Hola! Te invito a unirte a mi red. Registrate desde este link y empezamos juntos: {linkRegistro}");
}
<div class="card" style="margin-bottom:18px;">
    <div class="card-header">
        <span class="card-title">🔗 Tu link de referido</span>
        <span class="badge badge-info" style="font-size:11px;">Código: @Model.Usuario.CodigoReferido</span>
    </div>

    <div style="font-size:13px; color:var(--text-muted); margin-bottom:12px;">
        Compartí este link para que nuevas personas se registren bajo tu red.
    </div>

    <div id="link-referido-display"
         style="background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm);
                padding:11px 14px; font-size:12px; color:var(--sky); word-break:break-all;
                font-family:monospace; margin-bottom:12px; user-select:all;">
        @linkRegistro
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="@linkRegistro" target="_blank" rel="noopener noreferrer"
           class="btn btn-primary btn-sm">
            🔗 Abrir
        </a>
        <button onclick="copiarLinkReferido()" id="btn-copiar-ref"
                class="btn btn-secondary btn-sm">
            📋 Copiar
        </button>
        <a href="https://wa.me/?text=@mensajeWa"
           target="_blank" rel="noopener noreferrer"
           class="btn btn-sm"
           style="background:rgba(37,211,102,0.12); border:1px solid rgba(37,211,102,0.25); color:#25D366;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            WhatsApp
        </a>
        <button id="btn-share-ref" onclick="compartirNativoRef()"
                class="btn btn-secondary btn-sm" style="display:none;">
            ↗️ Compartir
        </button>
    </div>
</div>

<script>
const linkReferido = @Json.Serialize(linkRegistro);

function copiarLinkReferido() {
    navigator.clipboard.writeText(linkReferido).then(() => {
        const btn = document.getElementById('btn-copiar-ref');
        const orig = btn.textContent;
        btn.textContent = '✅ ¡Copiado!';
        btn.style.color = 'var(--green)';
        setTimeout(() => { btn.textContent = orig; btn.style.color = ''; }, 2500);
    });
}

async function compartirNativoRef() {
    try {
        await navigator.share({ title: 'Unite a mi red', text: 'Registrate desde mi link:', url: linkReferido });
    } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => {
    if (navigator.share) document.getElementById('btn-share-ref').style.display = 'flex';
});
</script>

<!-- REFERIDOS -->
<div class="card">
    <div class="card-header">
        <span class="card-title">👤 Mis referidos</span>
        <a href="/Referidos/MisReferidos" style="font-size:12.5px; color:var(--sky);">Ver todos →</a>
    </div>

    @if (!Model.Referidos.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">👥</div>
            <p>Aún no registraste ningún referido.<br>
            <a href="/Referidos/Crear" style="color:var(--sky);">Registrá tu primer referido</a></p>
        </div>
    }
    else
    {
        <table class="table table-responsive">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Referidos.Take(5))
            {
                var badgeClass = r.Estado switch {
                    EstadoReferido.Convertido => "badge-success",
                    EstadoReferido.Pagado     => "badge-info",
                    EstadoReferido.Cancelado  => "badge-danger",
                    _ => "badge-warning"
                };
                var estadoLabel = r.Estado switch {
                    EstadoReferido.Convertido => "Convertido",
                    EstadoReferido.Pagado     => "Pagado",
                    EstadoReferido.Cancelado  => "Cancelado",
                    _ => "Pendiente"
                };
                <tr>
                    <td data-label="Nombre"><strong>@r.NombreCompleto</strong></td>
                    <td data-label="Estado"><span class="badge @badgeClass">@estadoLabel</span></td>
                    <td data-label="Fecha">@r.FechaRegistro.ToString("dd/MM/yy")</td>
                    <td data-label="Acción">
                        @if (r.Estado == EstadoReferido.Pendiente)
                        {
                            <a href="/Referidos/LinkPago/@r.Id" class="btn btn-secondary btn-sm">💳 Link pago</a>
                        }
                        else if (r.Estado == EstadoReferido.Convertido)
                        {
                            <span style="font-size:12px; color:var(--green);">✓ Activo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    }
</div>

<!-- ÚLTIMOS MOVIMIENTOS -->
<div class="card">
    <div class="card-header">
        <span class="card-title">📊 Últimos movimientos</span>
    </div>

    @if (!Model.UltimosMovimientos.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <p>Sin movimientos aún</p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Motivo</th>
                    <th>Puntos</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.UltimosMovimientos)
                {
                    <tr>
                        <td>@m.FechaMovimiento.ToString("dd/MM/yy")</td>
                        <td><strong>@m.Motivo</strong></td>
                        <td style="color:var(--sky);">+@m.CantidadPuntos</td>
                        <td style="color:var(--green);">@(m.Monto > 0 ? "$" + m.Monto.ToString("N2") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
</div>