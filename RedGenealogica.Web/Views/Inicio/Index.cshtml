@* Index.cshtml — Landing principal *@
@{ 
    ViewData["Title"] = "Inicio";
    var producto = ViewBag.Producto as RedGenealogica.Web.Models.Producto;
    var estaLogueado = User.Identity?.IsAuthenticated == true;
    var refEnCiclo  = (int)(ViewBag.ReferidosEnCicloActual ?? 0);
    var faltanCiclo = (int)(ViewBag.FaltanParaCiclo ?? 3);
}

@* ── HERO ───────────────────────────────────────────────────────── *@
<div style="text-align:center; padding:60px 0 48px;">

    <div style="display:inline-block; background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.2); border-radius:20px; padding:6px 18px; font-size:12px; color:var(--sky); margin-bottom:20px; letter-spacing:0.5px;">
        📦 PRODUCTO DIGITAL + SISTEMA DE REFERIDOS
    </div>

    <h1 style="font-family:'Space Grotesk',sans-serif; font-size:clamp(32px,5vw,56px); font-weight:700; line-height:1.1; margin-bottom:20px; background:linear-gradient(135deg, var(--text) 0%, var(--sky) 60%, var(--indigo) 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">
        Fórmulas para fabricar<br>productos de limpieza
    </h1>

    <p style="color:var(--text-muted); font-size:17px; line-height:1.8; max-width:560px; margin:0 auto 36px;">
        Accedé a más de <strong style="color:var(--text);">30 fórmulas profesionales</strong> para elaborar tus propios productos de aseo, cocina y limpieza. Y si querés, también podés ganar dinero compartiéndolo.
    </p>

    @if (estaLogueado)
    {
        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href="/Usuario/Panel" class="btn btn-primary" style="padding:13px 32px; font-size:15px;">Ir a mi panel</a>
            <a href="/Contento/MiContenido" class="btn btn-secondary" style="padding:13px 32px; font-size:15px;">📚 Mi contenido</a>
        </div>
    }
    else
    {
        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href="/Autenticacion/Registro" class="btn btn-primary" style="padding:13px 32px; font-size:15px;">Quiero acceder</a>
            <a href="#como-funciona" class="btn btn-secondary" style="padding:13px 32px; font-size:15px;">Ver cómo funciona</a>
        </div>
    }
</div>

@* ── CARD DEL PRODUCTO ──────────────────────────────────────────── *@
@if (producto != null)
{
    <div style="max-width:720px; margin:0 auto 64px;">
        <div class="card" style="display:grid; grid-template-columns:@(string.IsNullOrEmpty(producto.ImagenUrl) ? "1fr" : "280px 1fr"); gap:0; overflow:hidden; padding:0;">
            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
            {
                <img src="@producto.ImagenUrl" alt="@producto.Nombre"
                     style="width:100%; height:100%; object-fit:cover; min-height:200px;" />
            }
            <div style="padding:28px;">
                <div style="font-size:11px; color:var(--sky); text-transform:uppercase; letter-spacing:1px; margin-bottom:8px;">Producto digital</div>
                <div style="font-size:22px; font-weight:700; margin-bottom:10px;">@producto.Nombre</div>
                @if (!string.IsNullOrEmpty(producto.Descripcion))
                {
                    <div style="font-size:14px; color:var(--text-muted); margin-bottom:18px; line-height:1.6;">@producto.Descripcion</div>
                }

                <div style="font-size:36px; font-weight:700; color:var(--green); font-family:'Space Grotesk',sans-serif; margin-bottom:6px;">
                    $@producto.Precio.ToString("N0")
                </div>
                <div style="font-size:12px; color:var(--text-muted); margin-bottom:20px;">Pago único — acceso permanente</div>

                @* Qué incluye *@
                <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:22px;">
                    <div style="font-size:13px; color:var(--text-muted); display:flex; align-items:center; gap:8px;">
                        <span style="color:var(--green);">✓</span> +30 fórmulas de productos de limpieza y aseo
                    </div>
                    <div style="font-size:13px; color:var(--text-muted); display:flex; align-items:center; gap:8px;">
                        <span style="color:var(--green);">✓</span> Jabones, detergentes, suavizantes, desengrasantes y más
                    </div>
                    <div style="font-size:13px; color:var(--text-muted); display:flex; align-items:center; gap:8px;">
                        <span style="color:var(--green);">✓</span> Acceso inmediato en PDF — leé online o descargá
                    </div>
                    <div style="font-size:13px; color:var(--text-muted); display:flex; align-items:center; gap:8px;">
                        <span style="color:var(--green);">✓</span> Proporciones industriales listas para producir
                    </div>
                </div>

                @if (estaLogueado)
                {
                    @* Progreso del ciclo del usuario logueado *@
                    <div style="background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px; margin-bottom:16px;">
                        <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">Tu progreso hacia el próximo premio</div>
                        <div style="display:flex; gap:8px; margin-bottom:8px;">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div style="flex:1; height:8px; border-radius:4px; background:@(i < refEnCiclo ? "var(--green)" : "var(--surface)");"></div>
                            }
                        </div>
                        <div style="font-size:12px; color:var(--text-muted);">
                            @if (faltanCiclo == 0)
                            {
                                <span style="color:var(--green);">🎉 ¡Ciclo completo! Premio disponible</span>
                            }
                            else
                            {
                                <span>Te faltan <strong style="color:var(--text);">@faltanCiclo referido@(faltanCiclo > 1 ? "s" : "")</strong> para ganar <strong style="color:var(--green);">$@producto.Precio.ToString("N0")</strong></span>
                            }
                        </div>
                    </div>
                    <a href="/Referidos/Crear" class="btn btn-primary" style="width:100%; justify-content:center;">+ Invitar un referido</a>
                }
                else
                {
                    <a href="/Autenticacion/Registro" class="btn btn-primary" style="width:100%; justify-content:center; padding:12px;">
                        Quiero acceder — $@producto.Precio.ToString("N0")
                    </a>
                    <div style="text-align:center; margin-top:10px; font-size:12px; color:var(--text-muted);">
                        ¿Ya tenés cuenta? <a href="/Autenticacion/Login" style="color:var(--sky);">Iniciá sesión</a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── CÓMO FUNCIONA ──────────────────────────────────────────────── *@
<div id="como-funciona" style="max-width:820px; margin:0 auto 64px;">

    <div style="text-align:center; margin-bottom:40px;">
        <div style="font-size:11px; color:var(--sky); text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;">El sistema explicado</div>
        <div style="font-size:28px; font-weight:700;">¿Cómo funciona el sistema de referidos?</div>
        <div style="font-size:15px; color:var(--text-muted); margin-top:10px; max-width:520px; margin-left:auto; margin-right:auto; line-height:1.7;">
            Comprás un producto real. Si después querés ganar dinero compartiéndolo, podés. No es obligatorio — es un beneficio extra.
        </div>
    </div>

    @* Paso a paso *@
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:16px; margin-bottom:40px;">
        <div class="card" style="text-align:center; padding:28px 20px;">
            <div style="font-size:32px; margin-bottom:12px;">📦</div>
            <div style="font-weight:600; font-size:15px; margin-bottom:8px;">1. Comprás el producto</div>
            <div style="font-size:13px; color:var(--text-muted); line-height:1.6;">Pagás una vez y accedés a todo el contenido digital de forma inmediata y permanente.</div>
        </div>
        <div class="card" style="text-align:center; padding:28px 20px;">
            <div style="font-size:32px; margin-bottom:12px;">🔗</div>
            <div style="font-weight:600; font-size:15px; margin-bottom:8px;">2. Compartís tu link</div>
            <div style="font-size:13px; color:var(--text-muted); line-height:1.6;">Si te parece valioso, compartís tu link personal. Cada persona que compre a través tuyo es tu referido.</div>
        </div>
        <div class="card" style="text-align:center; padding:28px 20px;">
            <div style="font-size:32px; margin-bottom:12px;">🎯</div>
            <div style="font-weight:600; font-size:15px; margin-bottom:8px;">3. Completás 3 referidos</div>
            <div style="font-size:13px; color:var(--text-muted); line-height:1.6;">Cuando 3 de tus referidos confirman su pago, completás un ciclo y ganás un premio equivalente al precio del producto.</div>
        </div>
        <div class="card" style="text-align:center; padding:28px 20px;">
            <div style="font-size:32px; margin-bottom:12px;">💰</div>
            <div style="font-weight:600; font-size:15px; margin-bottom:8px;">4. Cobrás tu premio</div>
            <div style="font-size:13px; color:var(--text-muted); line-height:1.6;">El saldo se acredita en tu cuenta. Podés solicitar el retiro cuando quieras por transferencia bancaria.</div>
        </div>
    </div>

    @* Aclaración honesta *@
    <div style="background:rgba(56,189,248,0.05); border:1px solid rgba(56,189,248,0.15); border-radius:var(--radius); padding:24px 28px; margin-bottom:32px;">
        <div style="font-weight:600; font-size:15px; color:var(--sky); margin-bottom:12px;">💡 Lo que hacemos diferente</div>
        <div style="display:flex; flex-direction:column; gap:10px; font-size:14px; color:var(--text-muted); line-height:1.7;">
            <div><strong style="color:var(--text);">El producto es real y tiene valor propio.</strong> Las fórmulas que vendemos sirven para fabricar y vender productos de limpieza — eso tiene valor independientemente de los referidos.</div>
            <div><strong style="color:var(--text);">Los referidos son opcionales.</strong> No estás obligado a referir a nadie. Muchos compradores solo quieren el contenido.</div>
            <div><strong style="color:var(--text);">No hay niveles infinitos.</strong> El sistema solo tiene dos niveles: vos ganás por tus referidos directos, y tu sponsor gana un bono menor cuando vos completás tu ciclo. Nada más.</div>
            <div><strong style="color:var(--text);">El premio viene de las ventas reales.</strong> Cada peso que ganás corresponde a una venta real de un producto digital. No hay dinero que "se crea de la nada".</div>
        </div>
    </div>

    @* Ejemplo numérico *@
    @if (producto != null)
    {
        <div class="card">
            <div class="card-header"><span class="card-title">📊 Ejemplo con números reales</span></div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; font-size:14px; color:var(--text-muted);">
                <div>
                    <div style="font-weight:600; color:var(--text); margin-bottom:12px;">Tus ganancias como referidor</div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; justify-content:space-between;">
                            <span>Precio del producto</span>
                            <span style="color:var(--text);">$@producto.Precio.ToString("N0")</span>
                        </div>
                        <div style="display:flex; justify-content:space-between;">
                            <span>Referidos necesarios</span>
                            <span style="color:var(--text);">3</span>
                        </div>
                        <div style="height:1px; background:var(--border); margin:4px 0;"></div>
                        <div style="display:flex; justify-content:space-between; font-weight:600;">
                            <span>Tu premio por ciclo</span>
                            <span style="color:var(--green);">$@producto.Precio.ToString("N0")</span>
                        </div>
                        <div style="font-size:12px; color:var(--text-dim); margin-top:4px;">
                            Con 6 referidos = 2 ciclos = $@((producto.Precio * 2).ToString("N0"))
                        </div>
                    </div>
                </div>
                <div>
                    <div style="font-weight:600; color:var(--text); margin-bottom:12px;">Bono como sponsor (abuelo)</div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <div style="display:flex; justify-content:space-between;">
                            <span>% base del producto</span>
                            <span style="color:var(--text);">@producto.PorcentajeAbueloComision%</span>
                        </div>
                        <div style="display:flex; justify-content:space-between;">
                            <span>Bono cuando tu referido completa ciclo</span>
                            <span style="color:var(--text);">$@((producto.Precio * producto.PorcentajeAbueloComision / 100).ToString("N0"))</span>
                        </div>
                        <div style="height:1px; background:var(--border); margin:4px 0;"></div>
                        <div style="font-size:12px; color:var(--text-dim);">
                            Este bono aumenta con tu rango (Bronce, Plata, Oro...)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* ── PREGUNTAS FRECUENTES ───────────────────────────────────────── *@
<div style="max-width:680px; margin:0 auto 64px;">
    <div style="text-align:center; margin-bottom:32px;">
        <div style="font-size:28px; font-weight:700;">Preguntas frecuentes</div>
    </div>
    <div style="display:flex; flex-direction:column; gap:12px;">
        @{
            var faqs = new[]
            {
                ("¿Tengo que referir gente para acceder al contenido?",
                 "No. Al comprar el producto accedés inmediatamente a todos los PDFs. Los referidos son completamente opcionales."),
                ("¿Es una pirámide?",
                 "No. En una pirámide no hay producto real. Acá vendemos fórmulas químicas con valor concreto: sirven para fabricar y vender productos de limpieza. El dinero que ganás viene de ventas reales, no de la entrada de nuevos participantes."),
                ("¿Cada cuánto puedo retirar mis ganancias?",
                 "Cuando quieras. Solicitás el retiro desde tu panel y el admin procesa la transferencia bancaria a tu CBU/alias."),
                ("¿Qué pasa si mis referidos no pagan?",
                 "Nada. Solo cobrás el premio cuando 3 referidos efectivamente pagan. Los referidos registrados pero sin pago no cuentan."),
                ("¿Puedo tener múltiples ciclos?",
                 "Sí. Cada 3 referidos pagos completás un nuevo ciclo y ganás otro premio. No hay límite de ciclos.")
            };
            foreach (var (pregunta, respuesta) in faqs)
            {
                <details class="card" style="padding:0; cursor:pointer; margin-bottom:0;">
                    <summary style="padding:16px 20px; font-weight:600; font-size:14px; list-style:none; display:flex; justify-content:space-between; align-items:center;">
                        @pregunta
                        <span style="color:var(--sky); font-size:18px; flex-shrink:0; margin-left:12px;">+</span>
                    </summary>
                    <div style="padding:0 20px 16px; font-size:13px; color:var(--text-muted); line-height:1.7;">
                        @respuesta
                    </div>
                </details>
            }
        }
    </div>
</div>

@* ── CTA FINAL ──────────────────────────────────────────────────── *@
@if (!estaLogueado)
{
    <div style="text-align:center; padding:48px 0 32px;">
        <div style="font-size:24px; font-weight:700; margin-bottom:12px;">¿Listo para empezar?</div>
        <div style="font-size:15px; color:var(--text-muted); margin-bottom:28px;">
            Accedé al contenido digital hoy y decidís después si querés referir.
        </div>
        <a href="/Autenticacion/Registro" class="btn btn-primary" style="padding:14px 40px; font-size:16px;">
            Crear cuenta gratis
        </a>
    </div>
}

<style>
details summary::-webkit-details-marker { display:none; }
details[open] summary span { transform:rotate(45deg); display:inline-block; }
</style>
