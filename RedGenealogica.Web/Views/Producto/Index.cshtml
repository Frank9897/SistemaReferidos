@* Producto/Index.cshtml — Ficha pública del producto *@
@model RedGenealogica.Web.Models.Producto
@{
    ViewData["Title"] = Model.Nombre;
    var estadoAcceso   = ViewBag.EstadoAcceso as string ?? "anonimo";
    var refEnCiclo     = (int)(ViewBag.ReferidosEnCiclo ?? 0);
    var faltanCiclo    = (int)(ViewBag.FaltanParaCiclo ?? 3);
    var ciclos         = (int)(ViewBag.CiclosCompletados ?? 0);
    var linkRegistro   = ViewBag.LinkRegistro as string ?? "/Autenticacion/Registro";
    var estaLogueado   = User.Identity?.IsAuthenticated == true;
    var yaPago         = estadoAcceso == "pagado";
    var sinPago            = estadoAcceso == "sin_pago";
    var pendienteActivacion = estadoAcceso == "pendiente_activacion";

    var urlProducto = ViewBag.UrlProducto as string ?? "";
    var mensajeWa = Uri.EscapeDataString(
        "Mirá este producto que encontré — fórmulas para fabricar productos de limpieza: " + urlProducto);
}

<div style="max-width:900px; margin:0 auto;">

    @* ── Breadcrumb ─────────────────────────────────────────────── *@
    <div style="font-size:13px; color:var(--text-muted); margin-bottom:20px; display:flex; align-items:center; gap:8px;">
        <a href="/" style="color:var(--text-muted);">Inicio</a>
        <span>›</span>
        <span style="color:var(--text);">@Model.Nombre</span>
    </div>

    <div style="display:grid; grid-template-columns:1fr 380px; gap:28px; align-items:start;">

        @* ── Columna izquierda: info del producto ───────────────── *@
        <div>
            @if (!string.IsNullOrEmpty(Model.ImagenUrl))
            {
                <img src="@Model.ImagenUrl" alt="@Model.Nombre"
                     style="width:100%; border-radius:var(--radius); margin-bottom:24px; max-height:340px; object-fit:cover;" />
            }
            else
            {
                <div style="width:100%; height:200px; background:linear-gradient(135deg, var(--bg3), var(--surface)); border-radius:var(--radius); display:flex; align-items:center; justify-content:center; font-size:64px; margin-bottom:24px;">
                    🧪
                </div>
            }

            <h1 style="font-size:26px; font-weight:700; margin-bottom:10px; line-height:1.2;">@Model.Nombre</h1>

            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <p style="color:var(--text-muted); font-size:15px; line-height:1.8; margin-bottom:24px;">@Model.Descripcion</p>
            }

            @* Qué incluye *@
            <div class="card" style="margin-bottom:20px;">
                <div class="card-header"><span class="card-title">📋 ¿Qué incluye?</span></div>
                <div style="display:flex; flex-direction:column; gap:10px;">
                    <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                        <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                        <span>Más de <strong>30 fórmulas profesionales</strong> para fabricar productos de limpieza del hogar e industrial</span>
                    </div>
                    <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                        <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                        <span>Jabones líquidos, detergentes, suavizantes, desengrasantes, ceras, shampoos y más</span>
                    </div>
                    <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                        <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                        <span>Proporciones industriales por 20, 50, 100 y 200 litros — listas para producir y vender</span>
                    </div>
                    <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                        <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                        <span>Acceso inmediato en PDF — leé online o descargá para siempre</span>
                    </div>
                    @if (Model.Pdfs.Any())
                    {
                        <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                            <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                            <span><strong>@Model.Pdfs.Count() documento@(Model.Pdfs.Count() > 1 ? "s" : "")</strong> incluido@(Model.Pdfs.Count() > 1 ? "s" : ""):
                                @string.Join(", ", Model.Pdfs.OrderBy(p => p.Orden).Select(p => p.Nombre))
                            </span>
                        </div>
                    }
                    <div style="display:flex; align-items:flex-start; gap:10px; font-size:14px;">
                        <span style="color:var(--green); flex-shrink:0; margin-top:2px;">✓</span>
                        <span>Bonus: sistema de referidos opcional para <strong>recuperar tu inversión</strong> con 3 referidos</span>
                    </div>
                </div>
            </div>

            @* Vista previa de los documentos (solo nombres, sin contenido) *@
            @if (Model.Pdfs.Any())
            {
                <div class="card">
                    <div class="card-header"><span class="card-title">📄 Documentos incluidos</span></div>
                    @foreach (var pdf in Model.Pdfs.OrderBy(p => p.Orden))
                    {
                        <div style="display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--border); font-size:13px;">
                            <span style="color:var(--sky); font-weight:600; min-width:20px;">@pdf.Orden.</span>
                            <span>@pdf.Nombre</span>
                            @if (yaPago)
                            {
                                <a href="/Contento/VerProducto/@Model.Id" style="margin-left:auto; color:var(--green); font-size:12px;">Ver →</a>
                            }
                            else
                            {
                                <span style="margin-left:auto; color:var(--text-dim); font-size:12px;">🔒 Requiere pago</span>
                            }
                        </div>
                    }
                    @if (!yaPago)
                    {
                        <div style="margin-top:12px; font-size:12px; color:var(--text-muted);">
                            Los documentos se desbloquean inmediatamente al confirmar el pago.
                        </div>
                    }
                </div>
            }
        </div>

        @* ── Columna derecha: CTA sticky ─────────────────────────── *@
        <div style="position:sticky; top:80px;">
            <div class="card">

                @* Precio *@
                <div style="text-align:center; padding:8px 0 20px;">
                    <div style="font-size:42px; font-weight:700; font-family:'Space Grotesk',sans-serif; color:var(--green);">
                        $@Model.Precio.ToString("N0")
                    </div>
                    <div style="font-size:13px; color:var(--text-muted);">Pago único — acceso permanente</div>
                </div>

                <div class="divider" style="margin-bottom:20px;"></div>

                @* CTA según estado *@
                @if (yaPago)
                {
                    <div style="background:rgba(34,197,94,0.08); border:1px solid rgba(34,197,94,0.2); border-radius:var(--radius-sm); padding:14px; margin-bottom:16px; text-align:center;">
                        <div style="font-size:22px; margin-bottom:6px;">🎉</div>
                        <div style="font-weight:600; color:var(--green); margin-bottom:4px;">¡Ya tenés acceso!</div>
                        <div style="font-size:12px; color:var(--text-muted);">Podés ver y descargar todos los documentos.</div>
                    </div>
                    <a href="/Contento/VerProducto/@Model.Id" class="btn btn-primary"
                       style="width:100%; justify-content:center; padding:13px; font-size:15px; margin-bottom:10px;">
                        📖 Ver mi contenido
                    </a>
                }
                else if (pendienteActivacion)
                {
                    <div style="background:rgba(56,189,248,0.07); border:1px solid rgba(56,189,248,0.2); border-radius:var(--radius-sm); padding:14px; margin-bottom:16px; text-align:center;">
                        <div style="font-size:22px; margin-bottom:6px;">🔓</div>
                        <div style="font-weight:600; color:var(--sky); margin-bottom:4px;">Activá tu cuenta</div>
                        <div style="font-size:12px; color:var(--text-muted);">Comprá este producto para activar tu cuenta y empezar a ganar.</div>
                    </div>
                    <a href="/Referidos/Crear" class="btn btn-primary"
                    style="width:100%; justify-content:center; padding:13px; font-size:15px; margin-bottom:10px;">
                        💳 Comprar para activar — $@Model.Precio.ToString("N0")
                    </a>
                    <div style="font-size:12px; color:var(--text-muted); text-align:center; margin-bottom:16px;">
                        Tu cuenta se activa automáticamente al confirmar el pago.
                    </div>
                }
                else if (sinPago)
                {
                    <a href="/Referidos/Crear" class="btn btn-primary"
                    style="width:100%; justify-content:center; padding:13px; font-size:15px; margin-bottom:10px;">
                        💳 Comprar ahora — $@Model.Precio.ToString("N0")
                    </a>
                    <div style="font-size:12px; color:var(--text-muted); text-align:center; margin-bottom:16px;">
                        Al comprar accedés inmediatamente al contenido.
                    </div>
                }
                else
                {
                    <a href="/Autenticacion/Registro" class="btn btn-primary"
                       style="width:100%; justify-content:center; padding:13px; font-size:15px; margin-bottom:10px;">
                        Quiero acceder — $@Model.Precio.ToString("N0")
                    </a>
                    <div style="font-size:12px; color:var(--text-muted); text-align:center; margin-bottom:16px;">
                        ¿Ya tenés cuenta?
                        <a href="/Autenticacion/Login" style="color:var(--sky);">Iniciá sesión</a>
                    </div>
                }

                @* Compartir *@
                <div class="divider" style="margin-bottom:16px;"></div>
                <div style="font-size:12px; color:var(--text-muted); margin-bottom:10px;">Compartir producto</div>
                <div style="display:flex; gap:8px;">
                    <a href="https://wa.me/?text=@mensajeWa" target="_blank" rel="noopener"
                       class="btn btn-sm"
                       style="flex:1; justify-content:center; background:rgba(37,211,102,0.12); border:1px solid rgba(37,211,102,0.25); color:#25D366;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        WhatsApp
                    </a>
                    <button onclick="navigator.clipboard.writeText(window.location.href).then(()=>{this.textContent='¡Copiado!';setTimeout(()=>this.textContent='Copiar link',2000)})"
                            class="btn btn-secondary btn-sm" style="flex:1; justify-content:center;">
                        Copiar link
                    </button>
                </div>

                @* Progreso de ciclo si está logueado *@
                @if (estaLogueado && !yaPago)
                {
                    <div class="divider" style="margin:16px 0;"></div>
                    <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">
                        Tu progreso hacia el próximo premio
                    </div>
                    <div style="display:flex; gap:6px; margin-bottom:8px;">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div style="flex:1; height:6px; border-radius:3px; background:@(i < refEnCiclo ? "var(--green)" : "var(--surface)");"></div>
                        }
                    </div>
                    <div style="font-size:12px; color:var(--text-muted);">
                        @if (faltanCiclo == 0)
                        {
                            <span style="color:var(--green);">🎉 ¡Completaste un ciclo!</span>
                        }
                        else
                        {
                            <span>Faltan <strong style="color:var(--text);">@faltanCiclo</strong> referido@(faltanCiclo > 1 ? "s" : "") para ganar
                            <strong style="color:var(--green);">$@Model.Precio.ToString("N0")</strong></span>
                        }
                    </div>

                    @* Link de referido para compartir *@
                    @if (!string.IsNullOrEmpty(ViewBag.LinkRegistro as string))
                    {
                        <div class="divider" style="margin:14px 0;"></div>
                        <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">Tu link de referido</div>
                        <div style="background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm); padding:8px 10px; font-size:11px; color:var(--sky); word-break:break-all; font-family:monospace; margin-bottom:8px;">
                            @ViewBag.LinkRegistro
                        </div>
                        <a href="https://wa.me/?text=@Uri.EscapeDataString("Registrate desde mi link y accedé al producto: " + (ViewBag.LinkRegistro as string ?? ""))"
                           target="_blank" class="btn btn-sm"
                           style="width:100%; justify-content:center; background:rgba(37,211,102,0.12); border:1px solid rgba(37,211,102,0.25); color:#25D366;">
                            Compartir por WhatsApp
                        </a>
                    }
                }

                @* Garantías *@
                <div class="divider" style="margin:16px 0 12px;"></div>
                <div style="display:flex; flex-direction:column; gap:8px; font-size:12px; color:var(--text-muted);">
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span style="color:var(--green);">🔒</span> Pago seguro vía MercadoPago
                    </div>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span style="color:var(--sky);">⚡</span> Acceso inmediato tras el pago
                    </div>
                    <div style="display:flex; gap:8px; align-items:center;">
                        <span style="color:var(--amber);">♾️</span> Acceso permanente, sin vencimiento
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Responsive: en mobile la columna derecha va abajo *@
<style>
@@media (max-width: 720px) {
    div[style*="grid-template-columns:1fr 380px"] {
        grid-template-columns: 1fr !important;
    }
    div[style*="position:sticky"] {
        position: static !important;
    }
}
</style>
