@* MisReferidos.cshtml — Views/Referidos/MisReferidos.cshtml *@
@model List<RedGenealogica.Web.Models.Referido>
@using RedGenealogica.Web.Enumeraciones
@{ 
    ViewData["Title"] = "Mis referidos";
    var baseUrl      = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var codigoRef    = ViewBag.CodigoReferido as string ?? "";
    var linkRegistro = $"{baseUrl}/Autenticacion/Registro?codigo={codigoRef}";
    var mensajeWa    = Uri.EscapeDataString($"Hola! Te invito a unirte a mi red. Registrate desde: {linkRegistro}");
}

<div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:22px; flex-wrap:wrap; gap:12px;">
    <div>
        <div class="section-title">👥 Mis referidos</div>
        <div class="section-subtitle">@Model.Count referido(s) registrado(s)</div>
    </div>
    <a href="/Referidos/Crear" class="btn btn-primary">+ Registrar nuevo</a>
</div>

@* ── Link de referido propio ─────────────────────────────────── *@
@if (!string.IsNullOrEmpty(codigoRef))
{
    <div class="card" style="margin-bottom:18px;">
        <div class="card-header">
            <span class="card-title">🔗 Tu link de referido</span>
            <span class="badge badge-info" style="font-size:11px;">@codigoRef</span>
        </div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:10px;">
            Compartilo para que nuevas personas se registren directamente bajo tu red.
        </div>
        <div id="link-ref-display"
             style="background:var(--bg3); border:1px solid var(--border); border-radius:var(--radius-sm);
                    padding:10px 14px; font-size:12px; color:var(--sky); word-break:break-all;
                    font-family:monospace; margin-bottom:10px; user-select:all;">
            @linkRegistro
        </div>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
            <a href="@linkRegistro" target="_blank" rel="noopener noreferrer"
               class="btn btn-primary btn-sm">🔗 Abrir</a>
            <button onclick="copiarRefLink()" id="btn-copiar-ref2"
                    class="btn btn-secondary btn-sm">📋 Copiar</button>
            <a href="https://wa.me/?text=@mensajeWa" target="_blank" rel="noopener noreferrer"
               class="btn btn-sm"
               style="background:rgba(37,211,102,0.12); border:1px solid rgba(37,211,102,0.25); color:#25D366;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                WhatsApp
            </a>
        </div>
    </div>
}

<script>
const _linkRefVal = @Json.Serialize(linkRegistro);
function copiarRefLink() {
    navigator.clipboard.writeText(_linkRefVal).then(() => {
        const b = document.getElementById('btn-copiar-ref2');
        const o = b.textContent;
        b.textContent = '✅ ¡Copiado!';
        b.style.color = 'var(--green)';
        setTimeout(() => { b.textContent = o; b.style.color = ''; }, 2500);
    });
}
</script>

<div class="card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">👥</div>
            <p>Aún no registraste ningún referido.<br>
            <a href="/Referidos/Crear" style="color:var(--sky);">Registrá tu primer referido →</a></p>
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Contacto</th>
                    <th>Producto</th>
                    <th>Estado</th>
                    <th>Registrado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var badgeClass = r.Estado switch {
                        EstadoReferido.Convertido => "badge-success",
                        EstadoReferido.Pagado     => "badge-info",
                        EstadoReferido.Cancelado  => "badge-danger",
                        _ => "badge-warning"
                    };
                    var estadoLabel = r.Estado switch {
                        EstadoReferido.Convertido => "Convertido",
                        EstadoReferido.Pagado     => "Pagado",
                        EstadoReferido.Cancelado  => "Cancelado",
                        _ => "Pendiente"
                    };
                    <tr>
                        <td><strong>@r.NombreCompleto</strong></td>
                        <td style="color:var(--text-muted);">
                            @(r.CorreoElectronico ?? r.Telefono ?? "—")
                        </td>
                        <td>@(r.Producto?.Nombre ?? "—")</td>
                        <td><span class="badge @badgeClass">@estadoLabel</span></td>
                        <td>@r.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (r.Estado == EstadoReferido.Pendiente)
                            {
                                <a href="/Referidos/LinkPago/@r.Id" class="btn btn-secondary btn-sm">💳 Ver link</a>
                            }
                            else if (r.Estado == EstadoReferido.Convertido)
                            {
                                <span style="font-size:12px; color:var(--green);">✓ Activo en la red</span>
                            }
                            else if (r.Estado == EstadoReferido.Pagado)
                            {
                                <span style="font-size:12px; color:var(--sky);">Esperando conversión</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@await Html.PartialAsync("_BotonVolver")
