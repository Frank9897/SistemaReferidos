@* _Layout.cshtml — Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>◆ @ViewData["Title"]</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>◆</text></svg>">
    <link rel="stylesheet" href="~/css/sistema-referidos.css" asp-append-version="true" />
</head>
<body>

    <header class="navbar-custom">
        <nav class="nav-container">

            <a href="/" class="logo" style="text-decoration:none;">◆ RedGenealogica</a>

            @* Botón hamburguesa — solo visible en mobile *@
            <button class="nav-hamburger" id="nav-hamburger" aria-label="Menú" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

            <div class="nav-links" id="nav-links">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a href="/" class="nav-link">Inicio</a>
                    <a href="/Usuario/Panel" class="nav-link">Mi panel</a>
                    <a href="/Contento/MiContenido" class="nav-link">📚 Contenido</a>
                    <a href="/Referidos/MisReferidos" class="nav-link">Referidos</a>
                    <a href="/Ranking" class="nav-link">Ranking</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Administrador" class="nav-link nav-link-admin">Admin</a>
                    }

                    <div class="nav-actions">
                        <!-- CAMPANA -->
                        <div class="notif-wrap" id="notif-wrap">
                            <button class="notif-btn" id="notif-btn" title="Notificaciones">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                </svg>
                                <span class="notif-badge" id="notif-badge" style="display:none">0</span>
                            </button>
                            <div class="notif-dropdown" id="notif-dropdown">
                                <div class="notif-header">
                                    <span style="font-weight:600; font-size:13.5px;">Notificaciones</span>
                                    <button class="notif-leer-todas" id="notif-leer-todas">Marcar todas leídas</button>
                                </div>
                                <div id="notif-lista">
                                    <div class="notif-empty">Sin notificaciones nuevas</div>
                                </div>
                                <a href="/Notificaciones" class="notif-ver-todas">Ver historial completo →</a>
                            </div>
                        </div>

                        <form asp-controller="Autenticacion" asp-action="Logout" method="post" class="logout-form">
                            <button type="submit" class="btn btn-secondary btn-sm">Salir</button>
                        </form>
                    </div>
                }
                else
                {
                    <a href="/Producto" class="nav-link">Ver producto</a>
                    <a href="/#como-funciona" class="nav-link">Cómo funciona</a>
                    <div class="nav-actions">
                        <a href="/Autenticacion/Login" class="nav-link">Iniciar sesión</a>
                        <a href="/Autenticacion/Registro" class="btn btn-primary btn-sm">Registrarse</a>
                    </div>
                }
            </div>

        </nav>
    </header>

    <main>
        <div class="main-container">
            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">✓ @TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-error">✕ @TempData["Error"]</div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="footer-custom">
        <p>© 2026 RedGenealogica · Todos los derechos reservados</p>
        <p style="margin-top:6px; font-size:12px;">
            <a href="/Inicio/Privacidad" style="color:var(--text-muted); text-decoration:none;">Política de Privacidad</a>
            &nbsp;·&nbsp;
            <a href="/Inicio/Terminos" style="color:var(--text-muted); text-decoration:none;">Términos de Servicio</a>
        </p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
    // ── Hamburguesa ──────────────────────────────────────────────────
    (function() {
        const hamburger = document.getElementById('nav-hamburger');
        const navLinks  = document.getElementById('nav-links');
        if (!hamburger || !navLinks) return;

        hamburger.addEventListener('click', function() {
            const open = navLinks.classList.toggle('open');
            hamburger.classList.toggle('open', open);
            hamburger.setAttribute('aria-expanded', open);
            document.body.style.overflow = open ? 'hidden' : '';
        });

        // Cerrar al hacer click en un link
        navLinks.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('open');
                hamburger.classList.remove('open');
                hamburger.setAttribute('aria-expanded', false);
                document.body.style.overflow = '';
            });
        });

        // Cerrar al hacer click fuera
        document.addEventListener('click', function(e) {
            if (!hamburger.contains(e.target) && !navLinks.contains(e.target)) {
                navLinks.classList.remove('open');
                hamburger.classList.remove('open');
                hamburger.setAttribute('aria-expanded', false);
                document.body.style.overflow = '';
            }
        });
    })();
    </script>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <script>
        (function () {
            const btn       = document.getElementById('notif-btn');
            const dropdown  = document.getElementById('notif-dropdown');
            const badge     = document.getElementById('notif-badge');
            const lista     = document.getElementById('notif-lista');
            const leerTodas = document.getElementById('notif-leer-todas');
            let abierto     = false;

            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                abierto = !abierto;
                dropdown.classList.toggle('show', abierto);
            });

            document.addEventListener('click', (e) => {
                if (!document.getElementById('notif-wrap').contains(e.target)) {
                    abierto = false;
                    dropdown.classList.remove('show');
                }
            });

            leerTodas.addEventListener('click', async () => {
                await fetch('/Notificaciones/MarcarTodasLeidas', { method: 'POST', headers: { 'RequestVerificationToken': getAntiforgeryToken() } });
                badge.style.display = 'none';
                lista.innerHTML = '<div class="notif-empty">Sin notificaciones nuevas</div>';
            });

            function renderItems(items) {
                if (!items || items.length === 0) {
                    lista.innerHTML = '<div class="notif-empty">Sin notificaciones nuevas</div>';
                    return;
                }
                lista.innerHTML = items.map(n => `
                    <div class="notif-item" data-id="${n.id}">
                        <div class="notif-item-titulo">${n.titulo}</div>
                        <div class="notif-item-msg">${n.mensaje}</div>
                        <div class="notif-item-fecha">${n.fecha}</div>
                        ${n.urlAccion ? `<a class="notif-item-link" href="${n.urlAccion}" onclick="marcarLeida(${n.id}, event)">Ver →</a>` : ''}
                    </div>
                `).join('');
            }

            async function polling() {
                try {
                    const res  = await fetch('/Notificaciones/NoLeidas');
                    const data = await res.json();
                    if (data.count > 0) {
                        badge.textContent   = data.count > 9 ? '9+' : data.count;
                        badge.style.display = 'flex';
                        renderItems(data.items);
                        if (!abierto && data.count > 0) mostrarToast(data.items[0]);
                    } else {
                        badge.style.display = 'none';
                        if (!abierto) lista.innerHTML = '<div class="notif-empty">Sin notificaciones nuevas</div>';
                    }
                } catch (e) {}
            }

            let toastUltimoId = null;
            function mostrarToast(notif) {
                if (notif.id === toastUltimoId) return;
                toastUltimoId = notif.id;
                const t = document.createElement('div');
                t.className = 'notif-toast';
                t.innerHTML = `<div class="notif-toast-titulo">${notif.titulo}</div><div class="notif-toast-msg">${notif.mensaje}</div>`;
                document.body.appendChild(t);
                requestAnimationFrame(() => t.classList.add('show'));
                setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 350); }, 4000);
                t.addEventListener('click', () => {
                    t.classList.remove('show');
                    setTimeout(() => t.remove(), 350);
                    if (notif.urlAccion) window.location.href = notif.urlAccion;
                });
            }

            window.marcarLeida = async function(id, e) {
                e?.preventDefault();
                await fetch(`/Notificaciones/MarcarLeida/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': getAntiforgeryToken() } });
                const item = lista.querySelector(`[data-id="${id}"]`);
                if (item) item.remove();
                await polling();
            };

            function getAntiforgeryToken() {
                return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            }

            polling();
            setInterval(polling, 30000);
        })();
        </script>
    }
<script src="~/js/sistema-referidos.js"></script>
</body>
</html>
